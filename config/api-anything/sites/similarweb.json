            "query:keys"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://pro.similarweb.com/#/digitalsuite/websiteanalysis/overview/website-performance/*/999/3m?webSource=Total&key={domain}"
      },
      "match": {
        "method": "GET",
        "host": "pro.similarweb.com",
        "path": "/widgetApi/SearchKeywords/NewSearchKeywords/Table"
