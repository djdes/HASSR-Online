{
  "name": "similarweb",
  "displayName": "Similarweb",
  "baseUrl": "https://www.similarweb.com",
  "description": "Similarweb competitive traffic intelligence, engagement metrics, traffic channels, referrals, outgoing links, popular pages, subfolders, audience interests, similar sites, and search keyword clusters",
