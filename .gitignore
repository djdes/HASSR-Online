# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Параллельные сборки для проверки (NEXT_DIST_DIR=.next-<что-то>):
# нужны, чтобы прогнать production-build, не затирая рабочий .next.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# deploy helpers (contain credentials)
_run.py
_deploy.py
haccp-deploy.tar
haccp-deploy.tar.gz

# claude
.claude/

# local editor
.vscode/
.worktrees/
.agent/backups/
.agent/tasks/journals-external-api/raw/
.external-token.secret
.sensor-token.secret
*.secret

.agent/tasks/journals-external-api/.external-token.secret
.agent/tasks/journals-external-api/.sensor-token.secret
.agent/tasks/*/PROD_CREDENTIALS.md

# Screenshots generated by scripts/capture-screenshots.ts — stored only on prod via CI
public/screenshots/

# Scratch screenshots / playwright artefacts inside per-task working dirs.
# The deploy workflow already excludes .agent entirely, but ignoring these
# locally keeps `git status` readable and prevents accidental staging.
.agent/**/*.png
.agent/**/*.jpg
.agent/**/*.jpeg
.agent/**/*.webp
.agent/**/*.mp4
.agent/**/*.webm
.agent/haccp-*.txt
.agent/haccp-*.html


# ESLint output
eslint-report.json

# Playwright MCP debug artefacts (console logs, page snapshots) — local-only
.playwright-mcp/

# Tuya broker debug log
cf2.log


dispatcher/logs/

# Скриншоты и снапшоты страниц, которые агенты кладут в корень при отладке — мусор
/*.png
/*.jpg
/*-snapshot.yml
/.dev-server*.log
.agent/tasks/*/e2e/creds.json

# приватные данные рантайма (реквизиты, факсимиле) — см. LEGAL_DIR
/.data/

# архивы деплоя — внутри .env/CLAUDE.md
.agent/**/*.tar

# Локальные инструкции и заметки с доступами — только на машине, не в репозитории
/CLAUDE.md
/KIMI_ONBOARDING.md
/docs/local-testing.md
/docs/FEATURES_AND_AUTOMATION.md
/docs/superpowers/plans/2026-05-09-race-siblings-fix.md
/.agent/tasks/telegram-notifications/DEPLOY_GUIDE.md
