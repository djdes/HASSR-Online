generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Аккаунт владельца — то, что человек покупает.
///
/// Организация перестала быть единицей биллинга: у сети из трёх кафе три
/// организации, но один договор и один лимит сотрудников. Тариф живёт
/// здесь, на Organization остаются legacy-зеркала на один релиз.
model Account {
  id                 String         @id @default(cuid())
  ownerUserId        String         @unique
  /// Каскад обязателен: без него удаление организации падало по
  /// внешнему ключу. Организация удаляется каскадом на пользователей,
  /// а на владельце висел аккаунт — и ROOT не мог удалить компанию.
  /// Организации такого аккаунта просто теряют привязку (accountId
  /// становится null) — их всё равно удаляют вместе с ним.
  owner              User           @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  subscriptionPlan   String         @default("free")
  subscriptionEnd    DateTime?
  planAutoUpgradedAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organizations      Organization[]
}

/// Членство человека в организации сверх «домашней» (`User.organizationId`).
///
/// Линейный сотрудник живёт в одной организации и строк здесь не имеет.
/// Владелец получает строку с role="owner" на каждую свою организацию,
/// приглашённый руководитель — role="manager" там, куда его пустили.
model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: Cascade)
  /// "owner" | "manager"
  role           String       @default("manager")
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Organization {
  id                             String                         @id @default(cuid())
  /// Автопродление подписки включено.
  ///
  /// Робокасса подключает рекуррент ТОЛЬКО на первом платеже серии, и
  /// «включить» его на уже оплаченный период технически нельзя — нужен
  /// новый платёж. Поэтому флаг ставится при оплате с согласием, а не
  /// отдельной кнопкой.
  recurringActive                Boolean                        @default(false)
  /// InvId первого платежа серии — по нему касса списывает следующие.
  recurringParentOrderId         Int?
  /// Когда автопродление отключили. Отключение доступно всегда и
  /// действует сразу; оплаченный период при этом сохраняется.
  recurringDisabledAt            DateTime?
  /// За какой `subscriptionEnd` уже отправлено предупреждение о
  /// списании. Оферта обещает уведомить за 3 дня, и слать его повторно
  /// каждый прогон крона нельзя.
  recurringNotifiedForEnd        DateTime?
  /// Сколько подряд не удалось списать. После трёх суток автопродление
  /// выключается — так написано в оферте.
  recurringFailedAttempts        Int                            @default(0)
  /// Короткий номер организации для префикса логинов сотрудников
  /// (`u12_`). Автоинкремент, а не срез cuid или ИНН: он стабилен
  /// при переименовании и смене реквизитов, короток настолько, что
  /// логин можно продиктовать по телефону, и уникален по построению.
  ///
  /// БЕЗ @unique намеренно. Деплой применяет схему через `prisma db push`
  /// без флагов, а тот отказывается добавлять unique-констрейнт на
  /// существующую таблицу («могут быть дубли») и обрывает весь шаг —
  /// вместе с сидами и перезапуском PM2. Уникальность и так даёт
  /// SERIAL: последовательность не выдаёт одно значение дважды.
  orgNo                          Int                            @default(autoincrement())
  name                           String
  /// Сокращённое название для шапки журналов и печатных форм. null —
  /// краткое название из ЕГРЮЛ или полное (см. src/lib/org-journal-name.ts).
  journalShortName               String?
  /// Общие наборы колонок таблиц журналов: { [код журнала]: { hidden, labels } }.
  /// Копируются в config.columns документов при создании и по «Применить ко
  /// всем документам» (см. src/lib/journal-columns.ts).
  journalColumnsJson             Json                           @default("{}")
  /// Состав бракеражной комиссии по коду журнала:
  /// { finished_product: [{ id, role, employeeId, employeeName }], … }.
  /// Копируется в config.commissionMembers активных и новых документов
  /// (см. src/lib/brakerage-commission-org.ts).
  journalCommissionJson          Json                           @default("{}")
  /// Свои названия разделов меню и журналов организации:
  /// { "journals": { "<код журнала>": "Своё" }, "sections": { "<ключ раздела>": "Своё" } }.
  /// Только для показа в кабинете, мини-приложении, QR-формах и Telegram;
  /// коды, адреса и данные не меняются, в печати, у проверяющего и в
  /// отчётах остаются официальные названия (см. src/lib/custom-names.ts).
  customNamesJson                Json                           @default("{}")
  /// Служебный код базы организации — по нему другие организации
  /// подключаются к общему справочнику блюд (см. src/lib/dish-pool.ts).
  serviceCode                    String?                        @unique
  /// Код чужой базы, к которой организация подключилась («Привязать журнал,
  /// служебный код»). Пусто — своя база.
  linkedServiceCode              String?
  /// "regular" — обычный объект; "directory" — мастер-кабинет справочников
  /// пула служебного кода (см. src/lib/master-directory.ts).
  kind                           String                         @default("regular")
  sharedDirectoryItems           SharedDirectoryItem[]
  journalColumnTemplates         JournalColumnTemplate[]
  /// Сфера заведения: restaurant | cafe | education | bakery | fastfood |
  /// production | other. Колонка переиспользована — раньше здесь лежал
  /// «тип производства» (meat/dairy/…), старые значения переводит
  /// LEGACY_SPHERE_MAP в src/lib/org-profile.ts.
  type                           String
  /// Форма собственности: private | chain | state | other.
  ownershipKind                  String                         @default("private")
  /// Сколько точек назвали при регистрации. С 2026-09-05 по этому числу
  /// анкета заводит здания-точки (`Building`) и включает
  /// `perLocationJournals`; само поле остаётся ответом анкеты.
  locationsCount                 Int                            @default(1)
  /// Точки (2026-09-05): вести документы журналов отдельно по каждому
  /// зданию (`Building` = точка). Пока false, здания — просто группы
  /// помещений, переключателя точек нет, документы создаются без
  /// `buildingId`. Включает анкета при «Точек» ≥ 2 и тумблер на
  /// /settings/buildings. См. docs/superpowers/specs/2026-09-05-locations-design.md
  perLocationJournals            Boolean                        @default(false)
  inn                            String?
  /// Профиль из ЕГРЮЛ/ЕГРИП по ИНН (DaData): реквизиты, руководитель, ОКВЭД,
  /// численность, капитал, финансы. Обновляется анкетой и кнопкой в настройках.
  legalProfileJson               Json?
  legalProfileUpdatedAt          DateTime?
  address                        String?
  phone                          String?
  /// Аккаунт-владелец. Nullable только на время миграции существующих
  /// организаций — после прогона scripts/migrate-multi-org.ts пустых нет.
  accountId                      String?
  account                        Account?                       @relation(fields: [accountId], references: [id])
  members                        OrganizationMember[]           @relation("OrganizationMembers")
  /// Legacy-зеркало тарифа. Правда живёт в Account; поля остаются на один
  /// релиз, чтобы не ломать читателей, которые ещё не переведены.
  subscriptionPlan               String                         @default("free")
  subscriptionEnd                DateTime?
  /// Когда организацию автоматически перевели с бесплатного тарифа на
  /// платный из-за превышения лимита в 5 сотрудников. Нужен, чтобы
  /// отличать авто-переход (оплата не требовалась — тестовый режим) от
  /// осознанной покупки и чтобы не переводить повторно.
  planAutoUpgradedAt             DateTime?
  /// Пауза за неактивность (cron auto-pause-inactive, 100 дней без
  /// записей). `pausedFromPlan` — куда вернуть при «Возобновить работу»;
  /// стадия и дата активности — дедуп предупреждений за 30/14/7/3/2/1
  /// день; `inactivityResumedAt` — точка отсчёта после возобновления.
  pausedFromPlan                 String?
  inactivityWarnedStage          Int?
  inactivityWarnedForActivityAt  DateTime?
  inactivityResumedAt            DateTime?
  /// Демо-организация: создана кнопкой «Посмотреть на демо-данных» после
  /// регистрации (одна на аккаунт). Живёт до demoExpiresAt, потом её
  /// удаляет cron purge-demo-orgs. Сотрудники демо не считаются в тарифе.
  isDemo                         Boolean                        @default(false)
  demoExpiresAt                  DateTime?
  locale                         String                         @default("ru")
  brandColor                     String?
  logoUrl                        String?
  yookassaShopId                 String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  /// Per-organisation bearer token for POST /api/external/entries. When set,
  /// overrides the shared EXTERNAL_API_TOKEN env and resolves the caller's
  /// organizationId automatically. Keep unique across orgs.
  externalApiToken               String?                        @unique
  /// Journal template codes the organization has chosen NOT to keep. Empty
  /// by default (= all 35 journals enabled). Toggled from /settings/journals
  /// so different production profiles (кафе, мясокомбинат, пекарня…) can
  /// hide the journals that don't apply. Disabled journals are muted in
  /// the browser and excluded from dashboard compliance counts.
  disabledJournalCodes           Json                           @default("[]")
  /// Когда руководитель нажал «Чек-листы проверены» в фазе «Документы»
  /// начальной настройки. null — фаза не закрыта (onboarding-core-status).
  checklistsReviewedAt           DateTime?
  /// Ids бумажных бланков (PAPER_JOURNALS), которые организация скрыла.
  /// Пусто = все бумажные журналы сферы показываются — хранение
  /// негативное, как у disabledJournalCodes: новый бланк в каталоге
  /// автоматически включён у всех, а не «забыт». Выключение — только
  /// презентация: карточка уходит с дашборда, но бланк и страница
  /// заполнения остаются доступны по прямой ссылке. /settings/journals.
  disabledPaperJournalIds        Json                           @default("[]")
  /// Journal template codes enabled for auto document creation. Every
  /// day a cron checks for codes in this list and ensures there is an
  /// active JournalDocument covering today; creates a month-long doc if
  /// missing. Manages via /settings/auto-journals.
  autoJournalCodes               Json                           @default("[]")
  /// Шаблон по умолчанию для журнала уборки и дезинфекции. Когда
  /// менеджер нажимает «Сохранить как шаблон» в журнале — текущий
  /// config (rooms, ответственные, scope-шаги, дни уборки)
  /// сериализуется сюда. Каждый новый JournalDocument для cleaning
  /// при создании смотрит сначала в это поле и копирует rooms +
  /// responsibles из шаблона; если поля нет — fallback на встроенные
  /// DEFAULT_ROOM_BLUEPRINTS. Manages из самого журнала уборки.
  defaultCleaningDocumentConfig  Json?
  /// Compliance toggle: when true, a previously-completed journal task
  /// can ONLY be re-opened for edit by management roles
  /// (manager/head_chef/owner/technologist) or ROOT. Default false —
  /// any user who originally filled a task is allowed to re-open and
  /// correct it. Toggled from /settings/compliance.
  requireAdminForJournalEdit     Boolean                        @default(false)
  /// Режим QR-форм заполнения без входа (2026-09-19): "public" — любой,
  /// кто отсканировал плакат, выбирает имя из списка; "pin" — имя +
  /// личный 4-значный PIN сотрудника; "auth" — вход под своим аккаунтом,
  /// имя не выбирается. Действует на /journal-fill, /equipment-fill, /room-fill.
  qrFillMode                     String                         @default("public")
  /// Compliance toggle: «фото-доказательство на каждом шаге pipeline'а».
  /// Когда true, в task-fill wizard'е каждый шаг подтверждается ТОЛЬКО
  /// после загрузки фотографии (камера телефона / выбор файла). Без
  /// фото кнопка «Сделал» заблокирована. Это превращает заполнение
  /// журнала из «галочки» в реальный evidence trail для проверок РПН.
  /// По умолчанию false — каждая орга включает по необходимости.
  requirePhotoOnTaskFillStep     Boolean                        @default(false)
  /// Experimental: Design v2 для журнальных интерфейсов. Когда true,
  /// journal-document-client'ы рендерят унифицированный V2Layout с
  /// общими компонентами (JournalToolbar, JournalSettingsModal, etc.)
  /// вместо своего legacy-layout'а. По умолчанию TRUE с 2026-05 —
  /// все Tier A/B/C журналы покрыты V2-стилем, регрессий не было,
  /// пользователи отзываются положительно (см. WhatsNewModal).
  /// Орга может откатиться через toggle в /settings/experimental
  /// (legacy-код жив в каждом journal-document-client как fallback).
  /// См. docs/PIPELINE-VISION.md раздел P3.
  experimentalUiV2               Boolean                        @default(true)
  /// Час суток (0-23 по локальному часовому поясу организации) когда
  /// смена заканчивается и cron auto-close срабатывает на shared-задачах
  /// без записей. По умолчанию 0 = полночь (23:59:59). Для ночных смен
  /// можно поставить, например, 6 — тогда «сегодня» длится до 06:00.
  shiftEndHour                   Int                            @default(0)
  /// «Допуск по QR»: сотрудники сами отмечают гигиену и здоровье по QR
  /// перед сменой; автозаполнение за них выключено, в конце дня —
  /// сводка «кто не отметился» ответственным (2026-09-22).
  healthQrRequired               Boolean                        @default(false)
  /// Compliance toggle: «закрытый день». Когда true — после `shiftEndHour`
  /// рядовые сотрудники не могут редактировать записи прошедших дней
  /// (PUT/PATCH/DELETE на JournalDocumentEntry). Только management
  /// (manager/head_chef/owner/technologist/root) может «приоткрыть»
  /// прошлый день — каждое такое редактирование пишется в AuditLog с
  /// reason. Для ХАССП — гарантирует, что официант не «допишет»
  /// вчерашний контроль t° задним числом.
  lockPastDayEdits               Boolean                        @default(false)
  /// Отклонение температуры: эскалация руководству. Когда true и
  /// ответственный за журнал не исправил отклонение за
  /// `deviationEscalationMinutes` — уведомление уходит управляющим
  /// (Telegram + e-mail). Ровно один раз на инцидент. Выключается в
  /// /settings/compliance: небольшой команде, где ответственный и
  /// есть руководитель, второе сообщение — просто шум.
  escalateDeviationsToManagement Boolean                        @default(true)
  /// Сколько минут ждём исправления от ответственного, прежде чем
  /// эскалировать руководству. Считается от момента, когда
  /// ответственному ушло уведомление. 5…1440.
  deviationEscalationMinutes     Int                            @default(60)
  /// OAuth-токен Yandex.Disk REST API (получается через /authorize). Если
  /// заполнен — еженедельный cron /api/cron/yandex-backup сохраняет туда
  /// JSON-дамп всех журналов за последние 7 дней. Хранится в открытом
  /// виде, потому что ресторатор сам выпускает app-token для нашего
  /// приложения и может его отозвать в любой момент через
  /// https://oauth.yandex.ru/client/applications.
  yandexDiskToken                String?
  /// Папка на Я.Диске куда писать бэкапы. По умолчанию /WeSetup.
  yandexDiskFolder               String                         @default("/WeSetup")
  /// Когда последний раз cron успешно загрузил дамп. Используем чтобы
  /// показать в /settings/backup карточке «последний бэкап: …» и в
  /// /dashboard health-check'е сигналить если бэкап старше 14 дней.
  yandexDiskLastBackupAt         DateTime?
  /// Email бухгалтера для еженедельной выгрузки списаний (LossRecord)
  /// в формате CSV под импорт в 1С:Бухгалтерия. Дёргается cron
  /// `/api/cron/losses-export-1c` по понедельникам. Если null —
  /// org не получает рассылку.
  accountantEmail                String?
  /// Когда последний раз ушла недельная сводка (крон weekly-digest); повтор не раньше чем через 6 дней.
  weeklyDigestSentAt             DateTime?
  /// Самоудаление: запрошено руководителем, удаляется кроном через 30 дней (lib/org-deletion.ts).
  deletionRequestedAt            DateTime?
  deletionRequestedById          String?
  /// Публичный бейдж «журналы ведутся в WeSetup»: opt-in и код страницы /b/<code>.
  badgeEnabled                   Boolean                        @default(false)
  badgeCode                      String?                        @unique
  /// IANA timezone для отображения дат и расчётов compliance.
  /// Default "Europe/Moscow" (UTC+3) — большинство клиентов в РФ.
  /// Используется для перевода дашборд/отчётов из UTC в локаль.
  /// Не путать с `shiftEndHour` — тот про границу смены, а это
  /// про общую локализацию интерфейса.
  timezone                       String                         @default("Europe/Moscow")
  /// K10 — outbound webhooks (Zapier-style). Каждый URL получает
  /// POST { event, organizationId, timestamp, payload } при
  /// significant событиях (capa.created, journal.rejected,
  /// equipment.expired etc.). Org сама может построить интеграцию
  /// с Zapier / Make / N8N не дожидаясь нашей разработки.
  webhookUrls                    String[]
  /// Per-template переопределение периода ведения журнала. Shape:
  /// { [templateCode]: { kind: "monthly"|"yearly"|"days"|"perpetual"|"single-day", days?: number } }.
  /// Если для template есть запись — она побеждает дефолтный
  /// resolveJournalPeriodKind. Days-режим режет окна от начала
  /// месяца: N=10 → 1-10 / 11-20 / 21-end. Управляется через
  /// /settings/journals (period column).
  journalPeriods                 Json                           @default("{}")
  /// Race-claim mode: "race" (default) — задачи блокируются после
  /// claim, остальные видят «занято». "shared" — все могут заполнять
  /// задачу одновременно, без one-active-task rule. "manual" —
  /// задачи назначаются админом точечно (force-assign).
  /// Управляется в /settings/role-presets или /settings/journal-flow.
  taskFlowMode                   String                         @default("race")
  /// Org-level overrides матрицы пресетов ролей (/settings/role-presets).
  /// Структура: `Partial<Record<PermissionPreset, Capability[]>>`. Если
  /// для пресета override отсутствует — применяются hardcoded defaults
  /// из `src/lib/permission-presets.ts`. `admin` пресет НЕ редактируется
  /// (всегда полный набор) — менять его в JSON бессмысленно, hasCapability
  /// игнорирует override на admin'е. По умолчанию `null` — все компании
  /// стартуют с дефолтов и при желании кастомизируют под свою команду.
  presetCapabilitiesJson         Json?
  /// Если `true`, «Отправить всем в TasksFlow» учитывает график смен
  /// (WorkShift) и пропускает журналы, ответственные которых не на
  /// смене сегодня. По умолчанию `false` — большинство org'ов не
  /// держат график смен в актуальном виде, и фильтр приводит к тому
  /// что админ нажимает «отправить всем», а ничего не отправляется.
  bulkAssignRespectShifts        Boolean                        @default(false)
  /// Pipeline-конфиги per-journal — JSON c шагами (название, средства,
  /// зона, что делать). Загружается в Mini App при открытии задачи и
  /// рендерится как вертикальный pipeline вместо свободной формы.
  /// Структура: { "<journalCode>": { "pipeline": [ { id, label,
  /// instruction?, checklist?: string[] } ] } }.
  /// Управляется в /settings/journal-pipelines.
  journalPipelinesJson           Json                           @default("{}")
  /// Per-journal responsible USERS (поверх per-position eligibility
  /// в `JobPositionJournalAccess`). Структура:
  /// { [journalCode]: { [slotId]: userId } }. У разных журналов
  /// разные slotId — например, у бракеража готовой продукции 3 слота
  /// (chef/member1/member2 — комиссия), у уборки 2 (supervisor/
  /// controller), у большинства один (main). Схема описана в
  /// src/lib/journal-responsible-schemas.ts. Управляется в
  /// /settings/journal-responsibles.
  journalResponsibleUsersJson    Json                           @default("{}")
  /// Phase D: per-journal task-режимы. Per-org карта вида
  ///   { [journalCode]: { distribution: "...", verification: "...",
  ///     siblingVisibility: boolean, ... } }
  /// Distribution — как раздаются TasksFlow-задачи (per-employee /
  /// per-area / per-shift / per-batch / one-summary / by-rota).
  /// Verification — режим проверки (summary-task / per-cell / none).
  /// Управляется в /settings/journal-task-mode. Если код не задан —
  /// дефолт из getDefaultTaskMode(journalCode).
  journalTaskModesJson           Json                           @default("{}")
  /// Per-org override сложности журналов (1-5). Используется для
  /// расчёта workload-balance — если в компании нет шеф-повара,
  /// задачи распределяются между поварами равномерно по
  /// difficulty × частота_заполнения. Default берётся из
  /// DEFAULT_DIFFICULTY в src/lib/journal-workload.ts. Управляется
  /// в /settings/journal-difficulty.
  /// Структура: { [journalCode]: 1 | 2 | 3 | 4 | 5 }
  journalDifficultyJson          Json                           @default("{}")
  /// Автоматизация журналов: автосоздание документов + ежедневное
  /// автозаполнение сегодняшнего дня (cron 06:00,
  /// /api/cron/journal-automation). Структура:
  ///   { [journalCode]: { autoCreate: boolean, autoFill: boolean } }
  /// Одна галочка в UI пишет оба флага сразу; раздельные поля оставлены
  /// под будущий «продвинутый» режим. Если ключа нет — autoCreate
  /// падает обратно на легаси-список `autoJournalCodes`, autoFill = false.
  /// Для новых организаций hygiene включён по умолчанию (см.
  /// defaultJournalAutomationJson в src/lib/journal-automation.ts).
  journalAutomationJson          Json                           @default("{}")
  /// Баланс бонусных баллов организации, 1 балл = 1 ₽. Меняется только
  /// вместе со вставкой строки в BalanceTransaction — см.
  /// src/lib/balance/ledger.ts. Отрицательным не бывает: списание идёт
  /// условным updateMany с проверкой `gte`.
  balanceRub                     Int                            @default(0)
  /// Реферальный код организации для ссылки /r/<code>. Создаётся лениво
  /// при первом заходе в «Баланс и бонусы».
  referralCode                   String?                        @unique
  /// Кто пригласил эту организацию (реферальная программа клиент → клиент).
  /// Ставится один раз при регистрации или первой оплате.
  referredByOrganizationId       String?
  referredAt                     DateTime?
  balanceTransactions            BalanceTransaction[]
  customerReviews                CustomerReview[]
  companyOrders                  CompanyOrder[]
  referralInvites                ReferralInvite[]
  users                          User[]
  areas                          Area[]
  journalEntries                 JournalEntry[]
  products                       Product[]
  nameSuggestions                NameSuggestion[]
  auditLogs                      AuditLog[]
  journalChecklistItems          JournalChecklistItem[]
  journalChecklistChecks         JournalChecklistCheck[]
  managerScopes                  ManagerScope[]
  batches                        Batch[]
  capaTickets                    CapaTicket[]
  temperatureDeviationIncidents  TemperatureDeviationIncident[]
  lossRecords                    LossRecord[]
  productionPlans                ProductionPlan[]
  changeRequests                 ChangeRequest[]
  staffCompetencies              StaffCompetency[]
  journalDocuments               JournalDocument[]
  jobPositions                   JobPosition[]
  notifications                  Notification[]
  botInviteTokens                BotInviteToken[]
  journalObligations             JournalObligation[]
  workShifts                     WorkShift[]
  jobPositionJournalAccess       JobPositionJournalAccess[]
  bonusEntries                   BonusEntry[]
  inspectorTokens                InspectorToken[]
  journalCloseEvents             JournalCloseEvent[]
  formFillTimings                FormFillTiming[]
  employeeJoinTokens             EmployeeJoinToken[]
  buildings                      Building[]
  journalTaskClaims              JournalTaskClaim[]
  tasksFlowIntegration           TasksFlowIntegration?
  tasksFlowOutbox                TasksFlowOutbox[]
  mercuryIntegration             MercuryIntegration?
  mercuryEnterprises             MercuryEnterprise[]
  mercuryVetDocuments            MercuryVetDocument[]
  mercuryOutbox                  MercuryOutbox[]
  staffPairTokens                StaffPairToken[]
  webPushSubscriptions           WebPushSubscription[]
  paperJournalDocuments          PaperJournalDocument[]
  printAgents                    PrintAgent[]
  printJobs                      PrintJob[]
  journalGuideTemplates          JournalGuideTemplate[]
  journalPipelineTemplates       JournalPipelineTemplate[]
  partnerClients                 PartnerClient[]                @relation("PartnerClients")
  journalPreviews                JournalPreview[]
  kioskDevices                   KioskDevice[]
  signatureEvents                SignatureEvent[]
  qrPinRequests                  QrPinRequest[]

  /// Общий планшет (2026-09-20): режим «киоск» — планшет привязан к орге,
  /// сотрудники подписывают записи личным ПИН. `kioskEnabled` — включён ли
  /// режим; `kioskIdleLockSeconds` — через сколько бездействия киоск
  /// перелочивается обратно на список сотрудников.
  kioskEnabled                   Boolean                        @default(false)
  kioskIdleLockSeconds           Int                            @default(90)
  /// Фото при входе по ПИН на общем планшете (opt-in руководителя). Кадр с
  /// фронтальной камеры прикладывается к подписи как доказательство «это
  /// был он». Снимается только при согласии сотрудника (User.kioskPhotoConsentAt).
  kioskPhotoRequired             Boolean                        @default(false)
  /// Сканы приказов к журналам (2026-09-24, пожелание РПН).
  journalOrderScans              JournalOrderScan[]

  @@index([isDemo, demoExpiresAt])
}

/// Общий планшет, привязанный к организации. Планшет живёт под device-cookie
/// `wesetup.kiosk` (id + HMAC), а не под чьей-то сессией: сам по себе даёт
/// только список сотрудников и ввод ПИН. `secretHash` — хеш device-секрета,
/// raw показывается один раз при enroll (как EmployeeJoinToken/InspectorToken).
model KioskDevice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Точка (здание), если у организации несколько — киоск показывает её штат.
  buildingId     String?
  /// Свободный лейбл для руководителя («Кухня», «Склад №2»).
  label          String
  /// SHA-256 от device-секрета; raw в БД не хранится.
  secretHash     String        @unique
  createdById    String
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, revokedAt])
}

/// Passkey (WebAuthn) сотрудника — настоящий Face ID / отпечаток его
/// собственного телефона. Ключ регистрируется в профиле; разблокировка
/// киоска и вход на сайт подписываются им (SignatureEvent.method "passkey").
/// Публичный ключ и счётчик — по спецификации WebAuthn, приватный ключ
/// никогда не покидает устройство.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// base64url credential id из аутентификатора.
  credentialId String    @unique
  /// COSE public key, base64url.
  publicKey    String
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// Подпись устройства для списка в профиле («iPhone», «Android»).
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Одноразовый challenge WebAuthn (регистрация и вход), живёт 5 минут.
/// Для входа без выбранного пользователя userId = null.
model WebAuthnChallenge {
  id         String    @id @default(cuid())
  userId     String?
  challenge  String
  /// "register" | "authenticate"
  kind       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// Журнал подписей — первоклассное доказательство «кто и как подтвердил запись».
/// Пишется при разблокировке киоска (method "kiosk_pin"), а в фазах 3–4 —
/// с фото (photoUrl) и по passkey. Отдельно от AuditLog: показывается инспектору
/// и в PDF, привязан к записи журнала через entryRef.
model SignatureEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Кто подписал (id из User; связь мягкая, чтобы событие пережило архивацию).
  userId         String
  /// Метод подтверждения личности.
  method         String
  /// Устройство-киоск, если подпись сделана на общем планшете.
  deviceId       String?
  ip             String?
  userAgent      String?
  /// Фото факта подписи (фаза 3), путь как у вложений журналов.
  photoUrl       String?
  /// Тип записи, к которой относится подпись: "journal_entry" | "document_entry".
  entryKind      String?
  /// Ссылка на запись: {templateId,entryId} или {documentId,employeeId,date}.
  entryRef       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  /// Подпись члена бракеражной комиссии под строкой документа
  /// (entryKind = "brakerage_row"): документ и id строки в config.rows.
  documentId     String?
  rowId          String?

  @@index([userId, createdAt])
  @@index([documentId, rowId])
}

/// Запрос сотрудника с QR-страницы: выдать PIN («Запросить доступ») или
/// сменить его. Сотрудник сам придумывает PIN, руководитель одобряет —
/// тогда PIN начинает работать. Хэш и шифрованная копия PIN стираются после
/// решения; одна ожидающая заявка на сотрудника и вид (новая заменяет прежнюю).
model QrPinRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Сотрудник (связь мягкая, как у SignatureEvent).
  userId         String
  /// "issue" — PIN ещё нет; "change" — сменить действующий.
  kind           String
  /// pending | approved | rejected | superseded | expired
  status         String       @default("pending")
  /// bcrypt желаемого PIN; стирается после решения.
  pinHash        String?
  /// Шифрованная копия для «Показать PIN» в карточке; стирается после решения.
  pinEncrypted   String?
  /// Откуда пришёл запрос: "journal-fill" | "room-fill" | "equipment-fill".
  source         String
  journalCode    String?
  documentId     String?
  ip             String?
  userAgent      String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([userId, status])
}

/// Корпус/точка бизнеса организации. У сети может быть несколько
/// зданий («Кухня № 1», «Цех на Ленина», «Бар у моря»). Каждое
/// здание содержит набор Room — это и есть «помещения», по которым
/// строятся журналы уборки и аналогичные. Settings: /settings/buildings.
model Building {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  address            String?
  /// Точки (2026-09-05): реквизиты точки для шапки PDF — у сети КПП и
  /// телефон свои на каждом адресе.
  kpp                String?
  phone              String?
  /// Наименование точки в шапке журналов и PDF — точное юридическое
  /// наименование по месту деятельности. В интерфейсе остаётся короткое
  /// `name`. Пусто — в шапке «название, адрес».
  journalName        String?
  sortOrder          Int                 @default(0)
  rooms              Room[]
  /// Точки (2026-09-05): документы и обязательства, привязанные к этому
  /// зданию как к точке. При удалении здания связь обнуляется —
  /// документы остаются в организации и становятся общими.
  journalDocuments   JournalDocument[]
  journalObligations JournalObligation[]
  /// Площадки этой точки в ФГИС «Меркурий».
  mercuryEnterprises MercuryEnterprise[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

/// Помещение в здании. Используется как row в матрице журнала
/// уборки: «Гостевая зона», «Мойка», «Горячий цех», «Бар». Имя —
/// свободный текст; `kind` — слабая типизация для иконок и pre-fill
/// (guest/kitchen/wash/bar/storage/other).
model Room {
  id                  String   @id @default(cuid())
  buildingId          String
  building            Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name                String
  kind                String   @default("other")
  sortOrder           Int      @default(0)
  /// Cleaning unification (2026-05-08): Room — единственный источник
  /// правды о уборке. Эти поля раньше дублировались в
  /// JournalDocument.config.rooms[i] (CleaningRoomItem) для каждого
  /// cleaning-документа, что приводило к рассинхрону: правишь в
  /// журнале — настройки буфера не обновляются и наоборот. Теперь:
  ///   • detergent       — что использовать для уборки
  ///   • currentScope    — Json string[] шагов «Текущая уборка»
  ///   • generalScope    — Json string[] шагов «Генеральная уборка»
  ///   • currentDays     — bitmask (bit 0=Пн ... 6=Вс) дни Текущей
  ///   • generalDays     — bitmask дни Генеральной
  /// JSON для scope (а не String[]) — гибче, позже можно расширить
  /// до { label, hint, requirePhoto } без миграции.
  /// См. docs/superpowers/specs/2026-05-08-cleaning-unification.md
  detergent           String?  @default("")
  currentScope        Json     @default("[]")
  generalScope        Json     @default("[]")
  currentDays         Int      @default(127)
  generalDays         Int      @default(0)
  /// 2026-05-08+: тип расписания per-scope. "weekly" — currentDays/
  /// generalDays bitmask повторяется каждую неделю. "monthly" —
  /// currentMonthDays/generalMonthDays массив конкретных дней месяца
  /// (включая special-токен "last" = последний день месяца). Это даёт
  /// гибкость для генеральной уборки «раз в месяц последнего числа»
  /// или «1 и 15». Дефолт "weekly" для совместимости.
  currentScheduleType String   @default("weekly")
  generalScheduleType String   @default("weekly")
  /// Json string[]: ["1", "15", "last"] и т.п. Применяется когда
  /// currentScheduleType / generalScheduleType == "monthly".
  currentMonthDays    Json     @default("[]")
  generalMonthDays    Json     @default("[]")
  /// 2026-05-08+: если true, в pipeline-шагах TasksFlow на каждом
  /// шаге включается photoMode='required'. Уборщица не может нажать
  /// «Сделал» без загрузки фото. Per-Room — все scope-шаги этой
  /// комнаты обязательно требуют фото.
  requirePhoto        Boolean  @default(false)
  /// 2026-09-04: кто убирает и кто проверяет это помещение — единственное
  /// место закрепления (карточка помещения в /settings/buildings и та же
  /// карточка из журналов). Порядок = приоритет: первый проверяющий
  /// уходит в TasksFlow как verifier задачи, остальные получают
  /// вечернюю сводку. Сотрудники архивируются, а не удаляются, поэтому
  /// читатели пересекают массивы с активными пользователями организации
  /// (см. src/lib/cleaning-room-responsibles.ts); при hard-delete
  /// сотрудника id вычищается из массивов (api/staff/[id]).
  cleanerUserIds      String[] @default([])
  /// «Кто заполняет» по QR помещения/склада; пусто — все (2026-09-22).
  fillerUserIds       String[] @default([])
  verifierUserIds     String[] @default([])
  /// 2026-09-04: единый справочник помещений для всех журналов. Нормы
  /// климата (журнал температуры/влажности по помещениям):
  /// { temperature: { enabled, min, max }, humidity: { enabled, min, max } }
  /// — зеркало ClimateMetricConfig (src/lib/climate-document.ts).
  /// null = нормы не заданы (документ климата использует дефолт
  /// 18…25 °C / 15…75 %).
  climateNorms        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([buildingId, sortOrder])
}

/// QR-код самостоятельной регистрации сотрудника. Админ нажимает «По
/// QR-коду» в /settings/users — генерируется токен. Распечатанный QR
/// или ссылка отдаётся новому сотруднику; он открывает /join/<token>,
/// вводит ФИО + телефон + выбирает должность из dropdown'а
/// организации, после чего создаётся User с привязкой к JobPosition
/// и ролью derived из categoryKey (management | staff). По умолчанию
/// он сразу попадает в иерархию (manager scope), а если есть
/// TasksFlow-интеграция — best-effort синкается туда по телефону и
/// получает все today's tasks через стандартный fan-out.
///
/// Один токен = одна регистрация. После claim'a пишется claimedAt +
/// claimedUserId, повторное использование возвращает 410 Gone. По
/// истечении expiresAt токен молча отклоняется (404).
model EmployeeJoinToken {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SHA-256 hash от raw токена. Raw показывается админу один раз при
  /// создании и больше нигде не хранится — как InviteToken/InspectorToken.
  tokenHash              String       @unique
  /// Подсказка: какую должность админ имел в виду. Юзер всё равно
  /// выбирает сам из dropdown'а, но если поле выставлено — оно
  /// preselected'ит вариант.
  suggestedJobPositionId String?
  /// User-кто-выписал. Помогает аудиту «кто впустил сотрудника».
  createdById            String
  expiresAt              DateTime
  claimedAt              DateTime?
  claimedUserId          String?
  /// Свободный лейбл для админа («Иванов И.И. цех №2») — UI показывает
  /// в списке выписанных QR.
  label                  String?
  createdAt              DateTime     @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

model User {
  id                          String                   @id @default(cuid())
  /// Контактная почта сотрудника. Отдельно от `email`: тот занят
  /// логином (или синтетикой вида staff-…@org.local.haccp) и
  /// уникален на всю платформу, а личный адрес может быть общим
  /// или отсутствовать вовсе.
  contactEmail                String?
  email                       String                   @unique
  name                        String
  phone                       String?
  passwordHash                String
  role                        String                   @default("cook")
  // Free-form job title that overrides the role-based label in journals.
  // Lets the same "cook" role user be displayed as "Повар холодного цеха" or
  // "Официант" per employee, instead of flipping between journals.
  positionTitle               String?
  /// PIN для QR-форм в режиме "pin" (bcrypt). null — PIN не задан.
  qrPinHash                   String?
  qrPinFailedCount            Int                      @default(0)
  qrPinLockedUntil            DateTime?
  /// «Уполномочен редактировать в бракеражных журналах список блюд»:
  /// по QR видит блюда за сегодня и правит наименование и время.
  canEditBrakerageDishes      Boolean                      @default(false)
  /// «Ответственный за ведение основных журналов» (гигиена и здоровье):
  /// по QR видит отметки всех за сегодня и правит их, получает сводку
  /// «кто не отметился» в конце дня (2026-09-22).
  keepsCoreJournals           Boolean                      @default(false)
  /// «Разрешение менять настройки»: одна галка вместо ролей — права
  /// руководителя на настройки кабинета (2026-09-22).
  canManageSettings           Boolean                      @default(false)
  /// Версия принятых юридических документов (оферта, соглашение, политика,
  /// согласие) — сравнивается с LEGAL_VERSION; история — в LegalConsent.
  legalVersion                String?
  /// Тот же PIN в обратимом шифре (AES-GCM, ключ INTEGRATION_KEY_SECRET/NEXTAUTH_SECRET),
  /// чтобы руководитель мог показать код сотруднику. null — задан до этой возможности.
  qrPinEncrypted              String?
  /// Согласие на фотофиксацию входа на общем планшете; null — фото не снимается.
  kioskPhotoConsentAt         DateTime?
  webAuthnCredentials         WebAuthnCredential[]
  /// «Домашняя» организация: где человека завели, где его должность,
  /// ACL и журналы. Для линейного сотрудника — единственная. Владелец и
  /// приглашённые руководители могут работать и в других — через
  /// OrganizationMember и активную организацию в сессии.
  organizationId              String
  organization                Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Организация, в которой человек работал в прошлый раз. Подставляется
  /// при входе, если членство ещё в силе.
  lastActiveOrganizationId    String?
  /// Точки (2026-09-05): последняя выбранная точка. Подставляется, когда
  /// cookie нет — на новом устройстве человек попадает в ту же точку.
  lastActiveBuildingId        String?
  organizationMemberships     OrganizationMember[]     @relation("OrganizationMemberships")
  ownedAccount                Account?                 @relation("AccountOwner")
  telegramChatId              String?
  notificationPrefs           Json?
  isActive                    Boolean                  @default(true)
  // Platform-level superadmin flag. Orthogonal to `role` (which is the in-org
  // job title). Root users still belong to a real `Organization`; the synthetic
  // "platform" org carries them so every existing FK/query keeps working.
  isRoot                      Boolean                  @default(false)
  // False until the owner has explicitly edited this user's journal ACL in
  // /settings/users. While false, `hasJournalAccess` grants all journals —
  // this gives zero-regression behaviour for employees predating the ACL.
  journalAccessMigrated       Boolean                  @default(false)
  // Soft-archive marker for the staff page. When set, the user disappears
  // from active lists + can no longer log in, but stays referenced by old
  // journal entries. Separate from `isActive` so the staff screen can
  // distinguish "uploaded an employee but disabled them" from "formally
  // dismissed / transferred to archive".
  archivedAt                  DateTime?
  // Structured job position reference. Optional — existing rows keep their
  // free-form `positionTitle` until the seed migration buckets them into
  // per-org `JobPosition` rows. New UI writes only `jobPositionId`; legacy
  // UI continues to read `positionTitle` via the getUserDisplayTitle helper.
  jobPositionId               String?
  jobPosition                 JobPosition?             @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                 @default(now())
  /// Personal permission override — JSON-массив кодов из
  /// src/lib/permissions.ts. null = наследовать от должности/группы.
  /// Индивидуальный override используется редко: «этот конкретный
  /// официант умеет принимать поставки и его надо пустить в batches».
  permissionsJson             Json?
  /// User-chosen colour theme. "light" | "dark". Sourced once on each
  /// page-load (dashboard layout, Mini App layout) so the choice
  /// follows the user across devices. localStorage caches it for FOUC
  /// suppression but DB is source of truth.
  themePreference             String                   @default("light")
  /// Показывать ли окно «Что нового» после обновления сервиса.
  /// По умолчанию да: смысл окна в том, чтобы человек узнал о новом,
  /// а кто не хочет — выключает в «Настройки → Внешний вид».
  /// Хранится в аккаунте, а не в браузере: иначе окно всплывало бы
  /// заново на каждом устройстве у того, кто его уже отключил.
  showWhatsNew                Boolean                  @default(true)
  /// Разовые уведомления, которые человек уже видел: `{ "<ключ>": true }`.
  /// Раньше отметка лежала в localStorage, и уведомление про автоматику
  /// гигиенического журнала всплывало заново в каждом браузере, где
  /// человек открывал сайт. «Один раз» — это про человека, а не про
  /// профиль браузера, поэтому отметка живёт в аккаунте.
  seenNoticesJson             Json                     @default("{}")
  /// Недельное правило выходных: 0=Пн … 6=Вс. Пустой массив = правило
  /// не задано (тогда выходные видны только из явных отметок
  /// StaffWorkOffDay). Правило избавляет управляющую от «прокликивания»
  /// Сб/Вс каждому сотруднику на месяц вперёд.
  weeklyDaysOff               Int[]                    @default([])
  /// Точки (2026-09-05): на каких зданиях-точках работает сотрудник.
  /// Пустой массив = на всех (обратная совместимость). Читатели
  /// пересекают с существующими зданиями организации: удалённая точка
  /// оставляет висящий id, который просто игнорируется.
  buildingIds                 String[]                 @default([])
  journalEntries              JournalEntry[]
  journalAccess               UserJournalAccess[]
  inviteToken                 InviteToken?
  botInviteToken              BotInviteToken?
  staffPairToken              StaffPairToken?
  webPushSubscriptions        WebPushSubscription[]
  workOffDays                 StaffWorkOffDay[]
  vacations                   StaffVacation[]
  sickLeaves                  StaffSickLeave[]
  dismissal                   StaffDismissal?
  notifications               Notification[]
  journalObligations          JournalObligation[]
  workShifts                  WorkShift[]
  entryAttachments            JournalEntryAttachment[]
  documentEntries             JournalDocumentEntry[]
  managerScopes               ManagerScope[]           @relation("ManagerScopes")
  defaultAssigneeForTemplates JournalTemplate[]        @relation("DefaultAssignee")
  bonusEntries                BonusEntry[]
  closedJournalEvents         JournalCloseEvent[]      @relation("ClosedBy")
  reopenedJournalEvents       JournalCloseEvent[]      @relation("ReopenedBy")
  formFillTimings             FormFillTiming[]
  journalTaskClaims           JournalTaskClaim[]
  verifiedClaims              JournalTaskClaim[]       @relation("ClaimVerifier")
  /// Permission preset — пресет прав доступа. Перекрывает legacy `role`
  /// для UI-gating и terminology. Пресеты:
  ///   "admin"     — полный доступ, видит журналы как журналы
  ///   "head_chef" — заведующая, видит staff + verification, не видит журналы
  ///   "cook"      — повар, только мини-апп задачи
  ///   "waiter"    — официант, только мини-апп задачи
  ///   "seller"    — продавец, мини-апп задачи + приёмка
  ///   "cashier"   — кассир, мини-апп задачи + списания
  ///   "cleaner"   — уборщик, только мини-апп задачи (узкий список)
  /// null → derive from role (legacy).
  permissionPreset            String?
  /// IP, с которого создан аккаунт. Заполняется один раз при регистрации
  /// и больше не меняется — ROOT по нему видит, откуда пришёл клиент,
  /// и отличает живую регистрацию от накрутки с одного адреса.
  registrationIp              String?
  /// IP и время последнего успешного входа. Перезаписываются при каждом
  /// логине (свой /api/auth/login, NextAuth-credentials и Telegram).
  /// Нужны в /root/metrics, чтобы понять, жив ли аккаунт и не сменился
  /// ли город/провайдер.
  lastLoginIp                 String?
  lastLoginAt                 DateTime?
  /// Версия сессий: растёт при «Завершить все сессии», см. lib/session-version.ts.
  sessionVersion              Int                      @default(0)
  /// Подтверждение входа кодом в Telegram (только при привязанном чате).
  twoFactorTelegram           Boolean                  @default(false)
  /// Личный токен ленты iCalendar (/api/calendar/<token>.ics); null — ссылка не создана.
  calendarToken               String?                  @unique
  /// Когда последний раз задавали вопрос NPS (или «не сейчас»); повтор через 90 дней.
  npsAskedAt                  DateTime?
  /// Когда человек подтвердил почту кодом. null — не подтверждал.
  /// Ничего не блокирует: это отметка для настроек и быстрого старта.
  emailVerifiedAt             DateTime?
  partnerApplications         Partner[]                @relation("PartnerApplicant")
  partnerMembership           PartnerUser?             @relation("PartnerMemberships")

  @@index([organizationId, archivedAt])
  @@index([jobPositionId])
  @@index([permissionPreset])
}

/// A custom job title (должность) an organisation has chosen to use.
/// `categoryKey` groups positions into the two columns from the staff page —
/// "management" (Руководство) and "staff" (Сотрудники). `sortOrder` lets the
/// owner drag positions around; unique (org, category, name) keeps duplicates
/// out.
model JobPosition {
  id              String                     @id @default(cuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "management" | "staff"
  categoryKey     String
  name            String
  sortOrder       Int                        @default(0)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  users           User[]
  workShifts      WorkShift[]
  /// JSON-массив permission-кодов (см. src/lib/permissions.ts). null =
  /// наследовать defaults группы (management/staff). Override для
  /// конкретной должности: «пекари тоже могут редактировать график».
  permissionsJson Json?
  journalAccess   JobPositionJournalAccess[]

  /// Список user.id, которых видят все сотрудники этой должности.
  /// Источник истины для:
  ///   • TasksFlow `users.managed_worker_ids` (через sync)
  ///   • Telegram-бот scope-фильтр (видимость других сотрудников)
  /// Пустой массив = «никого не видит» (только свои задачи). Если
  /// не задано (нет ManagerScope per-user тоже) — fallback на
  /// «видит всех» (back-compat). Редактируется через
  /// /settings/position-staff-visibility.
  visibleUserIds String[] @default([])

  /// «Видит ВСЕ задачи всех сотрудников в TasksFlow» — флаг для
  /// руководящих должностей. Когда true — sync ставит isAdmin=true
  /// в TasksFlow для всех юзеров этой должности (TF Dashboard
  /// показывает им все задачи компании). По умолчанию false для
  /// ВСЕХ должностей — admin orgi сам в /settings/task-visibility
  /// включает нужную (обычно одну, например «Админ» или
  /// «Управляющий»).
  ///
  /// Если ни у одной должности в орге не выставлено true —
  /// fallback на legacy behavior (первый management-юзер = isAdmin).
  /// Это back-compat для старых орг'ов которые ничего не
  /// настраивали.
  seesAllTasks Boolean @default(false)

  @@unique([organizationId, categoryKey, name])
  @@index([organizationId, sortOrder])
}

/// Hygiene-journal autofill input: a day the employee is off duty.
model StaffWorkOffDay {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Day at 00:00 UTC — stored as DateTime for Prisma friendliness.
  date      DateTime
  /// Явное исключение из недельного правила `User.weeklyDaysOff`:
  /// "off" — этот день выходной, хотя правило говорит «рабочий»,
  /// "work" — этот день рабочий, хотя правило говорит «выходной».
  /// Явная отметка всегда побеждает правило (в обе стороны).
  kind      String   @default("off")
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Vacation period (график отпусков) — inclusive on both ends.
model StaffVacation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateFrom  DateTime
  dateTo    DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([dateFrom, dateTo])
}

/// Sick-leave period (график больничных) — inclusive on both ends.
model StaffSickLeave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateFrom  DateTime
  dateTo    DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([dateFrom, dateTo])
}

/// Formal dismissal record (график увольнений). Unique per user — a single
/// dismissal is enough; if the employee is re-hired, remove the row + unarchive.
model StaffDismissal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
}

/// Смена сотрудника — «кто сегодня на работе и в какой роли». Именно
/// эта таблица делает возможным «Назначить задачу на должность, а не на
/// Иванова»: сохраняем расписание на каждый день, потом резолвер находит
/// дежурного с нужной `jobPositionId` на целевую дату. Если строки на
/// день нет — сотрудник считается не запланированным (исключается из
/// автосзначений).
model WorkShift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Якорь дня (UTC-midnight).
  date           DateTime
  /// На какой должности дежурит. Необязательно — fallback на jobPositionId
  /// пользователя из User.jobPositionId. Явно задаётся, если сотрудник
  /// сегодня подменяет другой пост (повар холодного цеха перекрывает
  /// горячий, например).
  jobPositionId  String?
  jobPosition    JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  /// scheduled | off | vacation | sick
  status         String       @default("scheduled")
  handoverNotes  String?
  handoverToId   String?
  handoverAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, date])
  @@index([organizationId, date])
  @@index([date, status])
}

/// Invite flow token. Created alongside a placeholder `User` when an owner
/// invites a new employee; mailed to them as /invite/<token> URL. The user
/// clicks, sets their password, and the token is marked `usedAt`.
///
/// `tokenHash` is a bcrypt/sha256 digest of the raw token — raw value never
/// persisted, so a DB leak cannot produce usable invite links.
model InviteToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Invite tokens for the Telegram-first onboarding flow (Mini App Stage 1).
/// Separate from `InviteToken` because semantics differ: `InviteToken` means
/// "set a password on the site", this one means "bind your Telegram identity".
/// Consumed by the grammy `/start inv_<token>` handler, which resolves the
/// token, writes `telegramChatId` on the matching User and activates them.
/// Read-only access tokens for SES / Роспотребнадзор inspector visits.
/// Created by org admin via /settings/inspector-portal — produces a TTL'd
/// share-link. Inspector opens /inspector/<token>, sees journals + entries
/// for the configured period in read-only mode, can download PDF за период
/// одной кнопкой.
///
/// Period is fixed at creation (no «slide forward»). Notes optional —
/// admin может пометить «проверка СЭС 2026-04-30 / Иванова И.И.».
/// Like InviteToken — only sha256 digest is persisted, raw token is shown
/// once on creation.
model InspectorToken {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String           @unique
  /// Free-form description set by admin (visible only in their list).
  label          String?
  /// Period the inspector is allowed to view (UTC midnight).
  periodFrom     DateTime
  periodTo       DateTime
  expiresAt      DateTime
  /// Bumped on every successful resolve — UI shows last-access stamp.
  lastAccessedAt DateTime?
  /// Total resolve count for usage stats.
  accessCount    Int              @default(0)
  /// Once admin clicks «Отозвать», token stops working without removing
  /// the row (audit trail of who/when/why).
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  /// Who issued the token (admin's userId). Helps audits and "кто впустил
  /// инспектора" forensics. Nullable for legacy and ROOT-issued tokens.
  createdById    String?
  visits         InspectorVisit[]

  @@index([organizationId])
  @@index([expiresAt])
}

/// B6 — Электронная подпись инспектора. Каждый раз когда инспектор
/// нажимает «Подтверждаю просмотр» на /inspector/<token>, мы создаём
/// row с timestamp + IP + user-agent + список просмотренных templates.
/// На стороне админа в /settings/inspector-portal — badge «Подписал
/// 2026-04-30 14:30». Compliance-проверка постфактум: видно кто и
/// когда смотрел журналы.
model InspectorVisit {
  id              String         @id @default(cuid())
  tokenId         String
  token           InspectorToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  signedAt        DateTime       @default(now())
  ipAddress       String?
  userAgent       String?
  /// ФИО / должность которое инспектор сам указал в форме «Подтверждаю».
  inspectorName   String?
  /// Список templateCodes которые он просмотрел в эту сессию.
  templatesViewed Json?

  @@index([tokenId])
}

/// Замер времени заполнения формы — «сколько секунд от open до submit».
/// Используется на ROOT-дашборде для UX-аналитики: какие формы тормозят
/// сотрудников, требуют упрощения. Платформенная метрика, в org UI не
/// показывается.
///
/// Запись создаётся в submit-handler'е task-fill / journal-documents
/// если client передал `openedAt` в payload. Старые клиенты без поля
/// просто не пишут timing — это OK.
model FormFillTiming {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Длительность от open formы до submit'а в миллисекундах.
  durationMs     Int
  /// "task-fill" | "document-edit" | "field-form" — для разделения
  /// сценариев в аналитике.
  source         String          @default("task-fill")
  createdAt      DateTime        @default(now())

  @@index([templateId, createdAt])
  @@index([organizationId, createdAt])
}

model BotInviteToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

/// Per-journal access grant for an employee. Rows only exist for explicit
/// grants; absence = no access (after `User.journalAccessMigrated` flips to
/// true). Managers / root bypass this table entirely.
model UserJournalAccess {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateCode String
  canRead      Boolean  @default(true)
  canWrite     Boolean  @default(true)
  canFinalize  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, templateCode])
  @@index([userId])
}

model Area {
  id             String         @id @default(cuid())
  name           String
  description    String?
  lat            Float?
  lng            Float?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment      Equipment[]
  journalEntries JournalEntry[]
}

model Equipment {
  id             String                   @id @default(cuid())
  name           String
  type           String
  serialNumber   String?
  tempMin        Float?
  tempMax        Float?
  tuyaDeviceId   String?
  areaId         String
  area           Area                     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  sensorMappings EquipmentSensorMapping[]
  /// «Кто заполняет»: только эти сотрудники могут отметить оборудование по
  /// QR (даже с верным PIN). Пусто — все (2026-09-22).
  fillerUserIds  String[]                 @default([])
  /// УФ-лампа: модель, ресурс по паспорту, дата установки, наработка.
  lampModel         String?
  lampLifetimeHours Int?
  lampInstalledAt   DateTime?
  /// Часы, накопленные с установки текущей лампы (включая «уже отработала»).
  lampUsedHours     Float                  @default(0)
  /// Лампа сейчас включена: с какого момента и кем.
  runningSince      DateTime?
  runningUserId     String?
  /// Последний отправленный порог ресурса: "warn" (≤10 %) | "over" (0).
  lampWarnLevel     String?
  runSessions       EquipmentRunSession[]
}

/// Сеанс работы оборудования (УФ-лампы): «Я включил» → «Я выключил».
model EquipmentRunSession {
  id             String    @id @default(cuid())
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  organizationId String
  startedAt      DateTime
  startedById    String
  endedAt        DateTime?
  endedById      String?
  /// Часы сеанса (после выключения).
  hours          Float?
  /// Документ журнала, куда записан сеанс.
  documentId     String?
  createdAt      DateTime  @default(now())

  @@index([equipmentId, startedAt])
  @@index([organizationId, endedAt])
}

/// Связь «датчик ↔ поле шаблона журнала». Один Tuya-девайс может
/// отдавать несколько метрик (`va_temperature`, `va_humidity`),
/// поэтому на один Equipment вешается N мапингов — по одному на
/// каждое поле, которое мы заполняем автоматически.
///
/// Используется только когда у соответствующего шаблона
/// `fillMode = "sensor"` — иначе мапинг игнорируется. Пишутся
/// `lastReadingAt` + `lastValue` чтобы UI мог быстро показать
/// «датчик жив», не ходя в Tuya API на каждый рендер.
model EquipmentSensorMapping {
  id            String          @id @default(cuid())
  equipmentId   String
  equipment     Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  templateId    String
  template      JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Ключ из `template.fields[].key` (e.g. "temperature", "humidity")
  fieldKey      String
  /// Какую метрику с устройства брать. Сейчас поддержаны
  /// "temperature" / "humidity"; список расширяется по мере
  /// поддержки новых типов журналов.
  readingType   String
  lastReadingAt DateTime?
  /// Сериализованное значение (числа храним как строку — потом
  /// парсим по типу поля шаблона; так гибче если появятся булевые
  /// или enum-метрики).
  lastValue     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([equipmentId, templateId, fieldKey])
  @@index([templateId])
}

/// Long-form article for the public /blog. Platform-level (not org-scoped)
/// — edited by ROOT in /root/blog and displayed to any visitor. Body is
/// structured as a JSON-serialized array of typed blocks
/// (paragraph / heading / list / quote) so we never have to ship a Markdown
/// parser or sanitise arbitrary HTML.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  /// ArticleBlock[] — see src/lib/article-blocks.ts
  body        Json
  coverIcon   String?
  tags        String[]  @default([])
  readMinutes Int       @default(5)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

/// User-submitted feedback from the in-app "Оставить обратную связь" modal.
/// Stored without FK relations on purpose: we keep a snapshot of userId /
/// email / name / org at submission time so reports stay readable after a
/// user or organisation is later deleted.
model FeedbackReport {
  id                String    @id @default(cuid())
  userId            String?
  userEmail         String?
  userName          String?
  organizationId    String?
  organizationName  String?
  /// "bug" | "suggestion" | "support"
  type              String
  message           String
  phone             String?
  /// "site" | "telegram" — откуда пришло обращение. Форма на сайте и в
  /// Mini App даёт "site", произвольное сообщение боту — "telegram".
  source            String    @default("site")
  /// Для source="telegram" — chat id автора: единственный адрес, по
  /// которому ответ поддержки может до него дойти (аккаунта может не быть).
  telegramChatId    String?
  /// Когда админ-уведомление реально ушло. null = канал промолчал, и это
  /// видно в /root/feedback, а не только в console.error.
  adminTgNotifiedAt DateTime?
  adminEmailedAt    DateTime?
  responseMessage   String?
  respondedAt       DateTime?
  respondedById     String?
  respondedByName   String?
  /// Вложения: [{ url, filename, mimeType, sizeBytes }] — как у SupportMessage.
  attachments       Json?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([source])
}

/// Онлайн-чат с поддержкой: одна ветка на пользователя.
///
/// Отдельно от `FeedbackReport`: обращение — это разовое «отправил и жду
/// ответа», а чат — переписка, где важен порядок реплик и то, что человек
/// видит всю историю аккаунта, вернувшись через неделю. Складывать реплики
/// в FeedbackReport пришлось бы через отношение «отчёт к отчёту», и панель
/// обращений перестала бы читаться.
model SupportThread {
  id               String   @id @default(cuid())
  /// Ключ ветки: "<userId>" (legacy, до веток организаций), "guest:<uuid>",
  /// "org:<orgId>". Колонка в БД по-прежнему называется userId — переименование
  /// только на уровне Prisma, чтобы `db push` не трогал данные.
  key              String   @unique(map: "SupportThread_userId_key") @map("userId")
  userEmail        String?
  userName         String?
  phone            String?
  organizationId   String?
  organizationName String?
  /// Последняя реплика — по ней сортируется список в админке.
  lastMessageAt    DateTime @default(now())
  /// Непрочитанное оператором: сбрасывается при ответе.
  unreadForStaff   Int      @default(0)
  /// Непрочитанное клиентом: +1 на реплику оператора, 0 когда клиент открыл чат.
  unreadForClient  Int      @default(0)
  createdAt        DateTime @default(now())

  messages SupportMessage[]

  @@index([lastMessageAt])
  @@index([organizationId])
}

model SupportMessage {
  id           String        @id @default(cuid())
  threadId     String
  thread       SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "client" | "operator"
  author       String
  body         String
  /// Кто ответил со стороны поддержки — показываем клиенту в чате.
  operatorName String?
  /// Вложения: [{ url, filename, mimeType, sizeBytes }]. JSON, а не
  /// отдельная таблица: вложение живёт и умирает вместе с сообщением,
  /// отдельного жизненного цикла у него нет. См. src/lib/support-attachments.ts.
  attachments  Json?
  /// Кто написал: управляющий организации (client) или сотрудник партнёра / ROOT (operator).
  authorUserId String?
  authorName   String?
  /// Партнёр, от имени которого написан ответ оператора. null — WeSetup.
  partnerId    String?
  /// Рассылка ROOT «всем организациям»: один id на рассылку, по нему
  /// пропускаем уже обработанные организации при повторе.
  broadcastId  String?
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([broadcastId])
}

/// In-app notifications that surface state-drift hints ("add these new
/// employees to hygiene journal", etc). Each row is scoped to a recipient
/// user inside an organisation and carries a typed payload in `items`.
///
/// We persist read/dismiss on the same row so the «Прочитанные» tab can
/// list history without a separate join table. `items` is a JSON array of
/// small objects that the client renders as a checkbox list — the shape
/// is typed in src/lib/notifications.ts.
model Notification {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Domain tag — e.g. "staff.added.journal". Used to dedupe with `key`.
  kind             String
  /// Stable dedupe key (e.g. "staff.added.journal:<journalCode>") so
  /// repeated triggers merge items into the existing open notification
  /// instead of piling up duplicates.
  dedupeKey        String
  title            String
  /// Optional inline link target, e.g. "/journals/hygiene".
  linkHref         String?
  linkLabel        String?
  items            Json         @default("[]")
  /// Подзадачи (items.id), которые юзер уже отметил как прочитанные.
  /// При выдаче GET /api/notifications эти id фильтруются из items;
  /// если после фильтра items пустой — readAt автоматически выставится
  /// и нотификация перейдёт в «Прочитанные». Это даёт UX «прочитать
  /// одну подзадачу из десяти, не закрывая всю задачу».
  dismissedItemIds Json         @default("[]")
  readAt           DateTime?
  dismissedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, dismissedAt, readAt])
  @@index([organizationId])
}

model JournalObligation {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId     String
  template       JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  journalCode    String
  kind           String          @default("daily-journal")
  dateKey        DateTime
  status         String          @default("pending")
  targetPath     String
  source         String          @default("daily-journal-sync")
  dedupeKey      String
  /// Точки (2026-09-05): по какой точке обязательство. null — общее
  /// (организация без точек). Сегмент точки входит в dedupeKey.
  buildingId     String?
  building       Building?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  openedAt       DateTime?
  completedAt    DateTime?
  /// Когда сотрудник «забрал» премиальное obligation через
  /// /api/journals/.../claim-bonus — заполняем эти поля атомарно
  /// одним UPDATE. Race-condition защита: уникальный constraint
  /// `claimedById` non-null + status="pending"-фильтр в WHERE.
  /// Используется только когда `template.bonusAmountKopecks > 0`.
  claimedById    String?
  claimedAt      DateTime?
  bonusEntry     BonusEntry?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, dateKey, status])
  @@index([organizationId, dateKey, status])
  @@index([templateId])
  @@index([claimedById])
  @@index([buildingId])
}

model JournalTemplate {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  name                String
  description         String?
  fields              Json
  isActive            Boolean                    @default(true)
  sortOrder           Int                        @default(0)
  isMandatorySanpin   Boolean                    @default(false)
  isMandatoryHaccp    Boolean                    @default(false)
  /// Распределение задач из этого журнала между сотрудниками:
  ///   "per-employee" — обязательство каждому подходящему сотруднику
  ///                    (гигиена, журнал здоровья — каждый за себя)
  ///   "single"       — одно обязательство на день: либо явно
  ///                    `defaultAssigneeId`, либо round-robin между
  ///                    подходящими сотрудниками
  ///   "sensor"       — заполняет IoT-датчик, людям не приходит
  ///                    (Фаза 2, пока заглушка)
  fillMode            String                     @default("per-employee")
  /// Используется только при `fillMode == "single"`. Если не null —
  /// обязательство всегда идёт этому пользователю; null → round-robin.
  defaultAssigneeId   String?
  defaultAssignee     User?                      @relation("DefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  /// Премиальная сумма (в копейках, чтобы не возиться с float-ами)
  /// за выполнение этого журнала. 0 — обычное обязательство без
  /// бонуса. Менеджер активирует через `/settings/journals` → у
  /// обязательств появляется кнопка «Взять с бонусом» (Фаза 3).
  bonusAmountKopecks  Int                        @default(0)
  /// Тип задачи в TasksFlow:
  ///   "personal" — закреплено за одним сотрудником, закрывается один
  ///                раз за смену (hygiene, health_check, cleaning).
  ///   "shared"   — общая задача смены, доступна всем подходящим по
  ///                роли. Может быть заполнена N раз в день (event-log:
  ///                acceptance, finished_product, complaint_register).
  /// Default "personal" для back-compat. Settings UI в /settings/journals/[code]
  /// позволяет менеджеру переопределить для своей организации (см.
  /// OrgJournalScopeOverride если потребуется per-org override).
  taskScope           String                     @default("personal")
  /// Можно ли в TasksFlow нажать «Не требуется сегодня» вместо
  /// заполнения. False для критичных журналов (health_check —
  /// нельзя отказаться от проверки здоровья).
  allowNoEvents       Boolean                    @default(true)
  /// Список стандартных причин для closure без событий. JSON-массив
  /// строк. Менеджер редактирует в /settings/journals/[code].
  noEventsReasons     Json                       @default("[\"Поставок/событий нет\",\"Заведение закрыто\",\"Оборудование не в работе\",\"Выходной/праздничный день\"]")
  /// Можно ли вводить свободный текст причины в дополнение к списку.
  /// False — только из готового списка (стандартизация для отчётов).
  allowFreeTextReason Boolean                    @default(false)
  entries             JournalEntry[]
  documents           JournalDocument[]
  journalObligations  JournalObligation[]
  positionAccess      JobPositionJournalAccess[]
  sensorMappings      EquipmentSensorMapping[]
  bonusEntries        BonusEntry[]
  closeEvents         JournalCloseEvent[]
  formFillTimings     FormFillTiming[]

  @@index([defaultAssigneeId])
}

/// Race-claim для пула общих задач журнала (rooms, fridges, areas …).
/// Сотрудник нажимает «Взять» в мини-аппе — атомарный INSERT по
/// уникальному ключу `(organizationId, journalCode, scopeKey)` решает,
/// кто первый. Остальные клиенты при следующем рендере видят занято.
///
/// scopeKey формат: `room:<roomId>:<YYYY-MM-DD>` для уборки,
/// `fridge:<equipmentId>:<shift>:<YYYY-MM-DD>` для холодильников и т.п.
/// Date-component включён в ключ — на следующий день всё снова свободно.
///
/// One-active-task rule: пока у юзера есть claim со status="active", он
/// не может взять другую задачу — клиент проверяет через
/// `getActiveClaimForUser`. Серверная защита в API endpoint claim.
///
/// status:
///   "active"    — взято, в работе, никто другой не может взять
///   "completed" — задача выполнена, записан entryId на JournalDocumentEntry
///   "released"  — отпустил без выполнения (передумал, передал коллеге)
///   "expired"   — auto-cleanup cron'ом если active более N часов без
///                 завершения (см. /api/cron/journal-claim-expire)
model JournalTaskClaim {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalCode        String
  /// Уникальный ключ задачи внутри (organizationId, journalCode).
  /// Включает date-component для дневного scope (см. doc выше).
  scopeKey           String
  /// Human-readable label для UI ("Зона 2 — Холодный цех", "Холодильник 1 утро").
  scopeLabel         String
  /// Дата задачи (UTC midnight) — для фильтрации в списках per-date.
  /// Дублирует часть scopeKey, но дешевле для индекса.
  dateKey            DateTime
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String       @default("active")
  claimedAt          DateTime     @default(now())
  completedAt        DateTime?
  releasedAt         DateTime?
  /// Свободный hint для UI — какой это был журнал/документ ("Уборка
  /// 28.04 — Холодный цех"). Используется в one-active-task tooltip.
  parentHint         String?
  /// FK на JournalDocumentEntry или JournalEntry, созданный при completion.
  /// Может быть null если completion ещё не написало entry.
  entryId            String?
  /// Для TasksFlow mirror — id задачи в TF, если она была создана.
  /// Если zero — claim только в WeSetup.
  tasksFlowTaskId    String?
  /// Verification от заведующей. После того как сотрудник завершил
  /// задачу (status=completed), заведующая получает её на проверку.
  /// pending — ждёт; approved — заведующая подтвердила; rejected —
  /// отклонила (сотрудник должен переделать).
  verificationStatus String?
  verifiedById       String?
  verifiedBy         User?        @relation("ClaimVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  verifierComment    String?
  /// Снимок form-data на момент complete'а — для verification UI
  /// (чтобы заведующая видела, что именно ввёл сотрудник).
  completionData     Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  /// Ключ к race-resolution: `INSERT ON CONFLICT DO NOTHING` через unique.
  /// Допускается несколько записей с тем же scopeKey разных статусов
  /// (released/expired не блокируют новые active), поэтому unique
  /// должен быть partial — увы, Prisma не умеет partial unique напрямую,
  /// поэтому моделируем через композитный unique с включением status:
  /// одна active-claim максимум. Старые released/expired не попадают
  /// под constraint потому что мы их не маппим в active status.
  ///
  /// Реализация: проверка перед INSERT в API +
  /// (organizationId, journalCode, scopeKey, status) unique. Так как
  /// Prisma поддерживает только не-partial — даём простой unique по
  /// (organizationId, journalCode, scopeKey, status), что значит
  /// «один active per scope, один released per scope, и т.д.» — для
  /// active это и нужно. Released/completed мы будем хранить только
  /// одной строкой scope-а.
  @@unique([organizationId, journalCode, scopeKey, status])
  @@index([userId, status])
  @@index([organizationId, journalCode, dateKey])
  @@index([organizationId, status])
}

/// Событие закрытия журнала за день — отдельное от обычных entry.
/// Создаётся когда сотрудник нажимает «Не требуется сегодня» / «Завершить
/// смену», или когда cron auto-close срабатывает в shiftEndHour.
///
/// Семантика kind:
///   "no-events"          — явное закрытие сотрудником с причиной
///                          (compliance ✅ зелёный)
///   "auto-closed-empty"  — cron закрыл по полуночи, никто не действовал
///                          (compliance 🟡 жёлтый — флаг халатности)
///   "closed-with-events" — сотрудник нажал «завершить смену» после
///                          N записей (compliance ✅ зелёный)
///
/// Reopen: если после закрытия случилось событие — сотрудник может
/// reopen'ить, тогда reopenedAt/reopenedByUserId заполняются. Запись
/// остаётся как audit trail (не удаляется).
model JournalCloseEvent {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId        String
  template          JournalTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// JournalDocument на которую относится closure. Null если журнал
  /// document-free (legacy field-based) — тогда date+template определяет.
  journalDocumentId String?
  journalDocument   JournalDocument? @relation(fields: [journalDocumentId], references: [id], onDelete: Cascade)
  /// UTC midnight того дня, который закрывается.
  date              DateTime
  /// Точки (2026-09-05): ключ точки в уникальном индексе — id здания или
  /// "" для общего закрытия организации (до точек и без точек).
  buildingKey       String           @default("")
  kind              String
  /// Текст причины (либо из noEventsReasons-list, либо free-text).
  /// Пусто для "auto-closed-empty" и "closed-with-events".
  reason            String?
  closedByUserId    String?
  closedBy          User?            @relation("ClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  /// Заполняется когда юзер reopen'ит закрытие после факта события.
  reopenedAt        DateTime?
  reopenedByUserId  String?
  reopenedBy        User?            @relation("ReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  /// На один (template, date, org) — одно закрытие. Reopen не плодит
  /// новых записей, обновляет существующую.
  @@unique([organizationId, templateId, date, buildingKey])
  @@index([organizationId, date])
  @@index([templateId, date])
}

/// Per-org white-list: каким должностям разрешено получать
/// обязательства по этому шаблону. Если для шаблона нет ни одной
/// записи — считаем что разрешены все должности (back-compat).
model JobPositionJournalAccess {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPositionId  String
  jobPosition    JobPosition     @relation(fields: [jobPositionId], references: [id], onDelete: Cascade)
  templateId     String
  template       JournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@unique([jobPositionId, templateId])
  @@index([organizationId, templateId])
}

/// Запись о начислении бонуса за выполнение премиального журнала.
/// Создаётся когда сотрудник нажимает «Взять с бонусом» на
/// `JournalObligation` у которого `template.bonusAmountKopecks > 0`.
///
/// Жизненный цикл (Фаза 3):
///   1. claim — `UPDATE JournalObligation SET claimedById=$user
///      WHERE status='pending'` транзакционно. Кто первый прошёл —
///      тому BonusEntry со status="pending" создаётся.
///   2. submit — сотрудник прикрепил фото и нажал «Готово». EXIF-
///      timestamp проверяется (<5 минут), при успехе → status="approved".
///   3. reject (опционально) — менеджер ретроактивно может перевести
///      запись в "rejected" с причиной.
///
/// Один BonusEntry на одно obligation — `obligationId @@unique`.
model BonusEntry {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  obligationId   String            @unique
  obligation     JournalObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  templateId     String
  template       JournalTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Сумма зафиксирована в момент claim (template может потом сменить
  /// `bonusAmountKopecks`, и это не должно ретроактивно поменять
  /// уже начисленные премии).
  amountKopecks  Int
  /// "pending" | "approved" | "rejected"
  status         String            @default("pending")
  /// Ссылка на JournalEntryAttachment с фото-доказательством. Может
  /// быть null до момента submit.
  photoUrl       String?
  /// EXIF-timestamp с фото, если получили — для аудита анти-фрода.
  photoTakenAt   DateTime?
  /// Менеджер который ретроактивно отозвал бонус (status="rejected").
  rejectedById   String?
  rejectedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([userId, status])
  @@index([templateId])
}

/// Память наименований организации (2026-09-19): что вписывали в окна
/// строк журналов — блюда (бракераж, интенсивное охлаждение) и продукция
/// (входной контроль, скоропорт). Выпадающий список в любом документе
/// предлагает их первыми, последние введённые — сверху. Отдельно от
/// `Product`: тот — справочник поставок с единицами и сроками, а здесь
/// просто строки, которые человек уже печатал.
model NameSuggestion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "dish" — готовые блюда, "product" — продукция/сырьё.
  scope          String
  value          String
  useCount       Int          @default(1)
  lastUsedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  /// Сопутствующие значения последнего ввода: для блюд — `{ productTemp }`.
  meta           Json?

  @@unique([organizationId, scope, value])
  @@index([organizationId, scope, lastUsedAt])
}

model Product {
  id             String       @id @default(cuid())
  name           String
  supplier       String?
  barcode        String?
  unit           String       @default("kg")
  category       String?
  storageTemp    String?
  shelfLifeDays  Int?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, name])
  @@index([organizationId, barcode])
}

model JournalEntry {
  id             String                   @id @default(cuid())
  templateId     String
  template       JournalTemplate          @relation(fields: [templateId], references: [id])
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  areaId         String?
  area           Area?                    @relation(fields: [areaId], references: [id])
  equipmentId    String?
  equipment      Equipment?               @relation(fields: [equipmentId], references: [id])
  filledById     String
  filledBy       User                     @relation(fields: [filledById], references: [id])
  data           Json
  status         String                   @default("submitted")
  /// Cross-journal traceability (Phase C). Уникальный ключ партии,
  /// одинаковый у всех связанных entries: incoming_control (приёмка) →
  /// finished_product (бракераж) → product_writeoff (списание). Позволяет
  /// в один запрос показать историю партии для прохождения трассировки
  /// по ХАССП (СанПиН + ТР ТС 021/2011 «Прослеживаемость продукции»).
  ///
  /// Формат: «<orgPrefix>-<YYYYMMDD>-<shortHash>».
  /// Auto-генерится для incoming_*; для других журналов — берётся
  /// пользователем через UI selector.
  batchKey       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  attachments    JournalEntryAttachment[]

  @@index([organizationId, templateId, createdAt])
  @@index([filledById])
  @@index([organizationId, batchKey])
}

model JournalEntryAttachment {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url          String
  filename     String
  mimeType     String       @default("image/jpeg")
  sizeBytes    Int          @default(0)
  createdAt    DateTime     @default(now())
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entryId])
}

model ManagerScope {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managerId              String
  manager                User         @relation("ManagerScopes", fields: [managerId], references: [id], onDelete: Cascade)
  /// Visibility mode: "all" = sees everyone, "job_positions" = sees specific job positions, "specific_users" = sees specific users, "none" = sees no one
  viewMode               String       @default("all")
  /// Job position IDs visible when viewMode = "job_positions"
  viewJobPositionIds     String[]
  /// User IDs visible when viewMode = "specific_users"
  viewUserIds            String[]
  /// Journal template codes this manager can assign tasks for. Empty = all journals they have access to.
  assignableJournalCodes String[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([organizationId, managerId])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  userName       String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

/// Ephemeral email verification codes used by the multi-step registration
/// wizard (/register -> /register/verify). `codeHash` is a bcrypt digest of
/// the 6-digit code; raw code is only present in the outgoing email.
/// `attempts` blocks brute-force guessing.
model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Audit log for every outgoing Telegram message. 30-day retention (cron).
/// Status transitions:
///   queued -> sent            (normal path)
///   queued -> failed          (non-429 Telegram error; `error` populated)
///   queued -> rate_limited    (429 after max retries)
model TelegramLog {
  id             String    @id @default(cuid())
  userId         String?
  organizationId String?
  chatId         String
  body           String
  kind           String?
  dedupeKey      String?
  status         String    @default("queued")
  error          String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  /// Тихие часы: отправить не раньше этого времени (status "deferred").
  deliverAfter   DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, organizationId, kind, dedupeKey, createdAt])
  @@index([status, createdAt])
  @@index([status, deliverAfter])
}

/// Состояние фоновой задачи между запусками. Нужно ровно для одного:
/// отличить разовый сетевой сбой, который сам себя вылечит ретраем, от
/// настоящей поломки. Алерт админу шлём только со второго подряд провала
/// (см. src/lib/platform-alerts.ts), а для этого счёт надо где-то хранить.
model CronRunState {
  /// Имя задачи: `tasksflow-poll`, `journal-automation`, ...
  job        String   @id
  /// Сколько запусков подряд закончились провалом. Успех обнуляет.
  failStreak Int      @default(0)
  lastError  String?
  updatedAt  DateTime @updatedAt
}

model Batch {
  id             String       @id @default(cuid())
  code           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productName    String
  supplier       String?
  quantity       Float
  unit           String       @default("kg")
  receivedAt     DateTime     @default(now())
  expiryDate     DateTime?
  status         String       @default("received")
  sourceEntryId  String?
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, expiryDate])
}

model CapaTicket {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  priority           String       @default("medium")
  status             String       @default("open")
  category           String       @default("other")
  sourceType         String?
  sourceEntryId      String?
  assignedToId       String?
  dueDate            DateTime?
  slaHours           Int          @default(24)
  rootCause          String?
  correctiveAction   String?
  preventiveAction   String?
  verificationResult String?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model LossRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  category       String
  productName    String
  quantity       Float
  unit           String       @default("kg")
  costRub        Float?
  cause          String?
  areaId         String?
  /// Документ-источник записи (акт списания), если потеря заведена из журнала.
  /// Необязательное — записи, заведённые руками, его не имеют.
  sourceEntryId  String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
  @@index([organizationId, category])
}

model ProductionPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime
  shift          String       @default("morning")
  items          Json
  status         String       @default("draft")
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, date, shift])
  @@index([organizationId, date])
}

model ChangeRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  changeType      String
  description     String?
  riskAssessment  String?
  testBatchResult String?
  status          String       @default("requested")
  version         Int          @default(1)
  requestedById   String?
  approvedById    String?
  implementedAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, status])
}

model StaffCompetency {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  skill          String
  level          Int          @default(0)
  certifiedAt    DateTime?
  expiresAt      DateTime?
  certifiedById  String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId, skill])
  @@index([organizationId, userId])
}

// ============================================================
// Document-based journals (grid: employees × days)
// Each JournalDocument = one printable document covering a date range.
// JournalDocumentEntry = one cell in the grid (employee + date + data).
// ============================================================

model JournalDocument {
  id                       String                 @id @default(cuid())
  templateId               String
  template                 JournalTemplate        @relation(fields: [templateId], references: [id])
  organizationId           String
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title                    String // e.g. "Гигиенический журнал"
  config                   Json?
  dateFrom                 DateTime
  dateTo                   DateTime
  responsibleUserId        String?
  responsibleTitle         String? // e.g. "Управляющий"
  /// Phase C двухступенчатой проверки. Кто принимает результат (verifier).
  /// Обычно management-роль (заведующая) — отдельная от заполнителей.
  /// Если null — fallback на responsibleUserId (back-compat для документов
  /// созданных до разделения filler/verifier).
  verifierUserId           String?
  /// Phase D пометка верификации сводной задачи. Сотрудник заполнил все
  /// слоты, задача-сводка ушла verifier'у — сюда пишем когда verifier
  /// одобрил/отклонил весь документ. Per-cell verifications живут в
  /// JournalDocumentEntry.verificationStatus (см. дальше).
  verificationStatus       String? // "pending" | "submitted" | "approved" | "rejected"
  verificationDecidedById  String?
  verificationDecidedAt    DateTime?
  verificationRejectReason String?
  status                   String                 @default("active") // active | closed
  autoFill                 Boolean                @default(false)
  createdById              String?
  /// Точки (2026-09-05): к какой точке (`Building`) относится документ.
  /// null — общий документ: создан до включения точек или организацией
  /// без точек; виден на каждой точке (см. buildingWhere в
  /// src/lib/building-scope.ts).
  buildingId               String?
  building                 Building?              @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  entries                  JournalDocumentEntry[]
  closeEvents              JournalCloseEvent[]
  printJobs                PrintJob[]

  @@index([organizationId, templateId, status])
  @@index([organizationId, dateFrom])
  @@index([organizationId, buildingId])
}

model JournalDocumentEntry {
  id                       String          @id @default(cuid())
  documentId               String
  document                 JournalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                     DateTime // the specific day (date-only, truncated to midnight)
  data                     Json // template-specific: { healthStatus: "healthy"|"day_off"|..., temperatureAbove37: false }
  /// Phase E — per-cell verification.
  ///   • null/"pending" — ячейка не прошла проверку.
  ///   • "approved"     — verifier одобрил эту ячейку.
  ///   • "rejected"     — verifier отклонил с rejectReason; сотруднику
  ///                       приходит push «у вас отклонили запись», поле
  ///                       помечается красной рамкой в UI и ждёт правки.
  verificationStatus       String?
  verificationRejectReason String?
  verificationDecidedById  String?
  verificationDecidedAt    DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@unique([documentId, employeeId, date])
  @@index([documentId, date])
}

// Stores responses keyed by Idempotency-Key header so retried POSTs to
// /api/external/entries return the same result without double-writing.
// TTL is enforced by a nightly job; do not rely on this table forever.
model JournalExternalIdempotency {
  key            String   @id
  organizationId String?
  journalCode    String?
  httpStatus     Int
  response       Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Audit log for every request hitting the external integration API.
// Keeps raw payload + outcome so we can debug upstream apps (employee app, sensor feed)
// without touching production logs.
model JournalExternalLog {
  id             String    @id @default(cuid())
  organizationId String?
  journalCode    String?
  date           DateTime?
  source         String? // e.g. "employee_app" | "sensor" | "manual"
  tokenHint      String? // last 4 chars of token used
  httpStatus     Int
  status         String // "ok" | "error"
  errorMessage   String?
  documentId     String?
  entriesWritten Int       @default(0)
  payload        Json?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([journalCode, createdAt])
}

/// Per-organization integration with TasksFlow (https://tasksflow.ru).
/// Stores the encrypted bearer key + base URL so WeSetup can push journal
/// rows as recurring tasks and receive completion events.
///
/// Encryption: `apiKeyEncrypted` is AES-256-GCM with INTEGRATION_KEY_SECRET.
/// `apiKeyPrefix` keeps the first 12 chars of the plaintext for UI display
/// ("tfk_abc123…") without exposing the secret.
///
/// One row per Organization — `organizationId @unique` enforces it.
model TasksFlowIntegration {
  id                 String              @id @default(cuid())
  organizationId     String              @unique
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseUrl            String
  /// AES-256-GCM ciphertext: `iv(base64).tag(base64).ciphertext(base64)`.
  apiKeyEncrypted    String
  /// First 12 chars of the original plaintext, for UI ("tfk_abc12345").
  apiKeyPrefix       String
  /// TasksFlow companyId resolved during connect (`whoami` or first task call).
  /// Null means we haven't been able to resolve it yet.
  tasksflowCompanyId Int?
  /// HMAC secret for the inbound webhook, generated on connect.
  webhookSecret      String
  enabled            Boolean             @default(true)
  lastSyncAt         DateTime?
  /// Free-form notes set by the integrator (e.g. "Test key", "Production").
  label              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  links              TasksFlowUserLink[]
  taskLinks          TasksFlowTaskLink[]
  outbox             TasksFlowOutbox[]

  @@index([organizationId])
}

/// Mapping between WeSetup `User` and a TasksFlow user (= worker). The
/// natural key is the phone number — TasksFlow logs in by phone, and we
/// auto-link any WeSetup user whose `phone` matches a TasksFlow user.
///
/// `tasksflowUserId` is nullable because we may have a phone match in
/// WeSetup before the cleaner has been imported into TasksFlow.
model TasksFlowUserLink {
  id                String               @id @default(cuid())
  integrationId     String
  integration       TasksFlowIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// WeSetup user (employee). Cascade-deleted when the user is removed.
  wesetupUserId     String
  /// Normalized phone (`+7XXXXXXXXX`). Stored lowercase, no spaces, so we
  /// can match against TasksFlow regardless of how either side typed it.
  phone             String
  tasksflowUserId   Int?
  tasksflowWorkerId Int?
  /// "auto" = matched by phone on sync; "manual" = pinned by an admin
  /// (don't overwrite during the next auto-sync).
  source            String               @default("auto")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([integrationId, wesetupUserId])
  @@index([integrationId, phone])
}

/// Records every task we created in TasksFlow on behalf of a WeSetup
/// journal row. Lets us update / delete / mark-complete the right
/// remote task without re-discovering it, and survives a journal row
/// edit (we update the existing TasksFlow task instead of orphaning it).
///
/// `journalDocumentId` + `rowKey` is the natural composite key on the
/// WeSetup side — `rowKey` is the journal-specific row identifier
/// (e.g. cleaning row id, or "<roomId>:<dateKey>" for matrix cells).
model TasksFlowTaskLink {
  id                String               @id @default(cuid())
  integrationId     String
  integration       TasksFlowIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  journalCode       String
  journalDocumentId String
  rowKey            String
  /// Phase E — kind задачи в TasksFlow:
  ///   • "filler"     (default) — задача-исполнителю на заполнение.
  ///   • "verifier"   — supervisor-задача проверяющему. Один на
  ///                    document. Клик по ней в TF ведёт в WeSetup
  ///                    verifier-view (?verify=1).
  kind              String               @default("filler")
  tasksflowTaskId   Int
  /// Last status received from TasksFlow ("active" | "completed").
  remoteStatus      String               @default("active")
  /// When TasksFlow reported completion (mirrored back to journal cell).
  completedAt       DateTime?
  /// Last sync direction: "push" (WeSetup → TasksFlow) or "pull" (the
  /// other way). Pure observability, doesn't change behaviour.
  lastDirection     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([integrationId, journalDocumentId, rowKey])
  @@index([tasksflowTaskId])
}

/// Бумажный журнал, который ведут через сайт: заполнили строки, сохранили,
/// распечатали, закрыли период. Работает так же, как электронные журналы —
/// с активными и закрытыми документами.
///
/// Юридически это НЕ замена бумаге: подписи в таких журналах живые, и
/// распечатанный лист с подписями остаётся единственным оригиналом. Здесь
/// хранится подготовка к печати, чтобы не перезаполнять бланк каждый раз.
model PaperJournalDocument {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Идентификатор бумажного журнала из `sphere-journal-rules` (`ot_intro` и т.п.).
  journalId         String
  title             String
  /// Строки бланка: массив массивов по колонкам журнала.
  rows              Json
  /// Кто проводит инструктаж — один на весь документ.
  responsible       String?
  /// Период документа из модалки создания. Без FK на User, как и
  /// остальные поля модели: `*UserId` нужны только чтобы модалка
  /// редактирования потом подставила выбранного человека обратно.
  dateFrom          DateTime?
  dateTo            DateTime?
  responsibleUserId String?
  /// Кто проверяет (колонка «ФИО проверяющего» есть не у всех).
  verifier          String?
  verifierUserId    String?
  status            String       @default("active") // active | closed
  closedAt          DateTime?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, journalId, status])
}

enum PrintJobStatus {
  pending
  printing
  done
  error
  cancelled
}

/// Установленный экземпляр программы «Онлайн принтер»: одна строка — одна
/// машина, к которой подключён принтер.
///
/// Токен хранится ТОЛЬКО хешем (как `InspectorToken`): плейнтекст
/// показывается один раз при подключении и на сервере не оседает. bcrypt
/// здесь не нужен — токен и так высокоэнтропийный, перебирать нечего.
model PrintAgent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Кто подключил машину — чтобы через полгода было понятно, чей это принтер.
  createdById    String?
  /// Имя машины: «Касса», «Кабинет заведующей». Задаётся при подключении.
  name           String
  tokenHash      String       @unique
  /// Выбранный принтер по умолчанию — агент присылает его при опросе.
  printerName    String?
  /// Все принтеры машины (JSON string[]) — чтобы в дашборде было видно,
  /// из чего человек выбирал.
  printers       Json?
  agentVersion   String?
  /// Обновляется при опросе с троттлингом: писать в БД каждые 5 секунд
  /// ради «онлайн» — дорого и незачем.
  lastSeenAt     DateTime?
  /// Отзыв из дашборда: токен перестаёт работать, строка остаётся, чтобы
  /// история печати не потеряла, на какой машине что печаталось.
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  jobs           PrintJob[]

  @@index([organizationId])
}

/// Задание печати.
///
/// Храним ССЫЛКУ на документ, а не сам файл: у Magday в очереди лежит
/// base64 чека — для чека нормально, для журнала за месяц это сотни
/// килобайт на строку. PDF агент забирает отдельным запросом, он и так
/// собирается на лету.
model PrintJob {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Пусто, пока задание не забрал агент.
  agentId        String?
  agent          PrintAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  documentId     String?
  document       JournalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Снимок названия: документ могут закрыть или удалить, а история печати
  /// должна читаться и через год.
  docTitle       String
  createdById    String?
  /// Снимок имени отправителя — по той же причине, что и docTitle.
  createdByName  String?
  status         PrintJobStatus   @default(pending)
  attempts       Int              @default(0)
  claimedAt      DateTime?
  printedAt      DateTime?
  errorMsg       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([agentId, status])
  /// Возврат зависших `printing` обратно в очередь.
  @@index([status, claimedAt])
}

enum TasksFlowOutboxStatus {
  pending
  delivered
  failed
}

/// Очередь outbound-команд от Wesetup в TasksFlow API. Реализует
/// П-15 (graceful degradation): команда сначала пишется в эту таблицу,
/// потом cron проигрывает её через TF REST API. Если TF недоступен —
/// команда остаётся в pending, повторяется с exponential backoff.
/// Idempotency-Key (П-19) защищает от дубликатов при retry.
///
/// Используется для:
///   • markClaimedByOther (race-siblings cleanup, П-2): payload={taskId,claimedByName,claimedByWorkerId}
///   • deleteTask (cleanup старых задач, П-16): payload={taskId}
///   • completeTask (manager закрыл ячейку в Wesetup, П-10): payload={taskId}
///   • verifyTask (manager подписал в Wesetup, П-14): payload={taskId}
model TasksFlowOutbox {
  id             String                @id @default(cuid())
  integrationId  String
  integration    TasksFlowIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// UUID-v4 для дедупа при retry. TasksFlow со временем должен принимать
  /// header Idempotency-Key (Фаза 2.8). Сейчас он только для нашей записи.
  idempotencyKey String                @unique
  /// "markClaimedByOther" | "deleteTask" | "completeTask" | "verifyTask"
  action         String
  /// JSON: { taskId: number, ...action-specific fields }
  payload        Json
  status         TasksFlowOutboxStatus @default(pending)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([integrationId, status])
  @@index([organizationId, status, createdAt])
}

/// Per-organization чеклист пунктов для журнала. Админ создаёт пункты
/// в /settings/journal-responsibles/[code]; повар видит их в TaskFill
/// перед отправкой формы. Required-пункты блокируют submit.
///
/// Чеклист — рабочий инструмент сотрудника (что физически сделать),
/// не данные журнала. В таблицу журнала идёт только итог («выполнено
/// + дата + подпись»). Каждая отметка галочки → JournalChecklistCheck.
///
/// Архивируется soft-delete (archivedAt) — старые чеки сохраняют
/// referential integrity, новые задачи не видят архивный пункт.
model JournalChecklistItem {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Один из ACTIVE_JOURNAL_CATALOG codes. Не FK на JournalTemplate
  /// чтобы пункты переживали изменения шаблона.
  journalCode     String
  /// Опциональная привязка к конкретной комнате (Room.id из Building).
  /// Используется для cleaning-журналов где разные комнаты имеют разные
  /// чек-листы:
  ///   • roomId=NULL   — общий пункт для всего журнала (по умолчанию)
  ///   • roomId="abc"  — пункт показывается ТОЛЬКО для задач этой комнаты
  ///                     (определяется по rowKey: room::<roomId>::cleaner::<uid>)
  /// Не FK на Room чтобы переживало удаление комнаты (soft-delete via
  /// archivedAt). При полном удалении комнаты пункт остаётся в БД но
  /// никогда не показывается.
  roomId          String?
  /// Текст пункта (видит сотрудник).
  label           String
  /// Сортировка (0, 1, 2, ...). Меньшее число = выше в списке.
  sortOrder       Int                     @default(0)
  /// Если true — submit формы блокируется пока не отмечено.
  required        Boolean                 @default(true)
  /// Опциональная подсказка/уточнение под пунктом.
  hint            String?
  /// Частота выполнения. По умолчанию `daily` — пункт показывается
  /// каждый день. Другие варианты:
  ///   • "weekly"  — только в дни weekDays (см. ниже)
  ///   • "monthly" — только в день monthDay месяца
  /// Если frequency не подходит к сегодняшней дате, пункт не
  /// показывается в TaskFill этого дня (но и не блокирует submit).
  frequency       String                  @default("daily")
  /// Дни недели для frequency=weekly. ISO-формат: 1=Пн, 7=Вс.
  /// Пример: [1,3,5] — пункт показывается Пн, Ср, Пт.
  weekDays        Int[]                   @default([])
  /// День месяца (1-31) для frequency=monthly. Если месяц короче,
  /// клиппим (день 31 в феврале → последний день февраля).
  monthDay        Int?
  /// Категория для cleaning-журнала. Авто-синхронизируется из
  /// `CleaningRoomItem.currentScope[]` / `generalScope[]` при сохранении
  /// помещения в /journals/cleaning/documents/[id] room-edit dialog.
  ///   • NULL       — обычный чек-лист (managed через /settings/journal-checklists)
  ///   • "current"  — пункт текущей уборки (auto-managed)
  ///   • "general"  — пункт генеральной уборки (auto-managed)
  /// На таких items HARM-edit запрещён через UI чек-листов (back-channel
  /// синхронизация перезаписывает).
  category        String?
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdByUserId String?
  /// Galочки по этому пункту (audit-trail кто-когда отметил).
  checks          JournalChecklistCheck[]

  @@index([organizationId, journalCode, archivedAt])
  @@index([organizationId, journalCode, sortOrder])
  @@index([organizationId, journalCode, roomId])
}

/// Запись отметки галочки чек-листа сотрудником в момент заполнения
/// журнала. Append-only — даже если юзер «снимает» галочку, мы пишем
/// новую запись с checked=false (не редактируем старую). Audit-trail
/// для проверок РПН.
///
/// Привязывается к taskFillTaskId (TasksFlow путь, HMAC-токен) или
/// к journalEntryId (in-app dashboard путь). Один из них заполнен.
model JournalChecklistCheck {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   JournalChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  /// TF-task если отметка пришла из task-fill flow.
  taskFillTaskId  Int?
  rowKey          String?
  /// In-app journal entry если отметка пришла из дашборда.
  journalEntryId  String?
  /// Состояние после события (true = отметили, false = сняли).
  checked         Boolean
  /// Кто отметил. userId nullable — TaskFill приходит без сессии,
  /// есть только rowKey-зашитый employeeId.
  checkedByUserId String?
  checkedByName   String?
  ipAddress       String?
  createdAt       DateTime             @default(now())

  @@index([checklistItemId, createdAt])
  @@index([organizationId, createdAt])
  @@index([taskFillTaskId, rowKey])
  @@index([journalEntryId])
}

/// P1 Pipeline Editor: guide-tree (как «инструкция») для сотрудника при
/// заполнении формы журнала на dashboard'е. Не связан с TasksFlow
/// pipeline'ом — это просто рендерится в FillingGuide modal'ке вместо
/// хардкоднутого текста. Один template на (organizationId, templateCode).
/// Если шаблона нет — показывается дефолтный гайд из `journal-spec.guide`.
model JournalGuideTemplate {
  id             String             @id @default(cuid())
  organizationId String
  templateCode   String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes          JournalGuideNode[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, templateCode])
  @@index([organizationId])
}

/// Узел гайда. Tree через parent/children. `ordering: Float` чтобы
/// drag-drop работал без reindexing — берём (prev + next) / 2.
/// `photoUrl` — illustrative картинка («вот так выглядит грязный фильтр»).
model JournalGuideNode {
  id         String               @id @default(cuid())
  templateId String
  template   JournalGuideTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     JournalGuideNode?    @relation("guide_children", fields: [parentId], references: [id], onDelete: Cascade)
  children   JournalGuideNode[]   @relation("guide_children")
  title      String
  detail     String?              @db.Text
  ordering   Float
  photoUrl   String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([templateId, parentId, ordering])
}

/// P1 Pipeline Editor: pipeline-tree, по которому работает worker
/// внутри TasksFlow / Mini App. Шаги делятся на pinned (привязаны к
/// колонке журнала через linkedFieldKey, не удаляются) и custom
/// (добавлены админом, можно удалять). Один template на
/// (organizationId, templateCode). Если шаблона нет — generic-адаптер
/// падает на legacy «свободная форма с photo-evidence» поведение.
model JournalPipelineTemplate {
  id             String                @id @default(cuid())
  organizationId String
  templateCode   String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nodes          JournalPipelineNode[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([organizationId, templateCode])
  @@index([organizationId])
}

/// Узел pipeline'а. Виды:
/// - kind="pinned" — системный, привязан к колонке журнала через
///   linkedFieldKey. Когда worker заполнит — value пойдёт в
///   JournalDocumentEntry.data[linkedFieldKey]. Удалять нельзя
///   (только title/detail/hint можно редактировать).
/// - kind="custom" — добавлен админом. Можно удалять.
/// `photoMode`: "none" | "optional" | "required" — фото-доказательство.
/// `requireComment` / `requireSignature` — добавляют поля комментария
/// и подписи на этом шаге. Required-* блокируют кнопку «Сделал».
model JournalPipelineNode {
  id               String                  @id @default(cuid())
  templateId       String
  template         JournalPipelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           JournalPipelineNode?    @relation("pipeline_children", fields: [parentId], references: [id], onDelete: Cascade)
  children         JournalPipelineNode[]   @relation("pipeline_children")
  kind             String                  @default("custom")
  linkedFieldKey   String?
  title            String
  detail           String?                 @db.Text
  hint             String?                 @db.Text
  ordering         Float
  photoMode        String                  @default("none")
  requireComment   Boolean                 @default(false)
  requireSignature Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([templateId, parentId, ordering])
  @@index([templateId, kind])
}

/// Производственный календарь РФ — официальные выходные, праздники и
/// сокращённые рабочие дни. Парсится из публичных источников (hh.ru,
/// consultant.ru) либо вручную через scripts/seed-production-calendar.ts.
///
/// Используется ВСЕМИ журналами с date-cells (cleaning, climate, hygiene
/// и др.):
///   • визуальная подсветка ячеек (красный пастель / жёлтый пастель);
///   • bulk-actions «Отметить выходные» — admin одной кнопкой ставит
///     значение в выходные сразу за весь период;
///   • compliance-логика — задачи в TasksFlow не назначаются на праздники.
///
/// Глобальная таблица (без organizationId): календарь РФ единый.
model ProductionCalendarDay {
  /// Дата в ISO-формате `YYYY-MM-DD` — primary key, никаких дубликатов.
  date      String   @id
  /// Год для query-фильтрации без парсинга string.
  year      Int
  /// Тип дня:
  ///   • "workday"   — обычный рабочий
  ///   • "weekend"   — Сб/Вс
  ///   • "holiday"   — праздник (1 января, 9 мая и т.п.) → красный пастель
  ///   • "short"     — сокращённый рабочий (предпраздничный) → жёлтый пастель
  kind      String
  /// Опциональное название праздника («Новый год», «День Победы»).
  /// Показывается в tooltip на ячейке.
  name      String?
  /// Источник: "hh.ru", "consultant.ru", "manual", "seed".
  source    String   @default("seed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year, kind])
}

/// Тарифы платформы, которые Wesetup продаёт через Робокассу.
///
/// Раньше цена «1 990 ₽/мес» была захардкожена в лендинге и калькуляторе,
/// и любое изменение требовало деплоя. Теперь цена живёт в БД и правится
/// ROOT'ом в /root/tariffs — лендинг, /pricing и создание платежа читают
/// одну и ту же строку.
///
/// Глобальная таблица (без organizationId): тарифы одни для всех клиентов.
model PlatformTariff {
  /// Стабильный ключ, на который ссылаются кнопки и PaymentOrder:
  ///   • "monthly" — «Подписка»
  ///   • "bundle"  — «Подписка + оборудование» (сумма железа считается
  ///     сервером по hardware-pricing.ts и прибавляется к priceRub)
  key        String   @id
  title      String
  priceRub   Int
  /// На сколько дней продлевает подписку организации после оплаты.
  periodDays Int      @default(30)
  active     Boolean  @default(true)
  sort       Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Заказ на оплату через Робокассу — от нажатия кнопки до заведённой
/// организации.
///
/// Жизненный цикл status:
///   pending   — заказ создан, платёж ещё не подтверждён
///   paid      — пришёл ResultURL с валидной подписью, деньги получены,
///               организация и пользователь заведены/продлены
///   completed — клиент дозаполнил профиль (название, имя, пароль)
///   failed    — зарезервировано под ручное закрытие проблемных заказов
model PaymentOrder {
  /// Уходит в Робокассу как InvId, поэтому именно int (int32), не uuid.
  id                     Int              @id @default(autoincrement())
  email                  String
  tariffKey              String
  amountRub              Decimal          @db.Decimal(10, 2)
  description            String
  /// Состав калькулятора для тарифа "bundle": { deviceId: qty }.
  bundleConfig           Json?
  status                 String           @default("pending")
  /// Платёж проведён в тестовом режиме Робокассы (ROBOKASSA_IS_TEST=1) —
  /// от этого зависит, каким паролем проверяется подпись.
  isTest                 Boolean          @default(false)
  organizationId         String?
  userId                 String?
  /// sha256 одноразового токена достройки профиля; сам токен уходит
  /// клиенту письмом и в success-возврате.
  completeTokenHash      String?          @unique
  completeTokenExpiresAt DateTime?
  /// Сырое тело ResultURL — для разбора спорных платежей.
  rawResult              Json?
  createdAt              DateTime         @default(now())
  paidAt                 DateTime?
  completedAt            DateTime?
  /// Согласие на автосписания, данное при оформлении этого заказа.
  /// false — разовый платёж, рекуррент не подключается.
  recurringConsent       Boolean          @default(false)
  /// Для автосписаний серии — id родительского заказа, по которому
  /// касса списывает. У обычного платежа пусто.
  recurringChargeOf      Int?
  /// Slug партнёра из cookie `wesetup.partner-ref` на момент оформления:
  /// после оплаты новая организация привязывается к нему.
  partnerSlug            String?
  /// Оборудование из bundle отгружено — ROOT отмечает вручную, после
  /// этого партнёру начисляется вознаграждение за железо (П. 5.2 ТЗ).
  shippedAt              DateTime?
  /// Возврат платежа — ROOT отмечает вручную; начисления сторнируются.
  refundedAt             DateTime?
  /// Сколько баллов организации списано в счёт этого заказа.
  /// gross = amountRub + pointsSpent; amountRub — то, что уходит в кассу.
  pointsSpent            Int              @default(0)
  /// Организация-реферер из cookie `wesetup.ref` на момент оформления.
  referrerOrganizationId String?
  /// "card" — Робокасса; "invoice" — счёт по безналу, оплату подтверждает ROOT.
  paymentMethod          String           @default("card")
  /// До какой даты действителен счёт по безналу.
  invoiceDueAt           DateTime?
  /// Промокод, применённый при оформлении (в верхнем регистре), и скидка в рублях.
  promoCode              String?
  discountRub            Int              @default(0)
  partnerAccruals        PartnerAccrual[]

  @@index([email])
  @@index([status])
  /// История оплат организации в ROOT-панели читается по этому индексу.
  @@index([organizationId])
  @@index([recurringChargeOf])
}

/// История согласий на автоматические списания.
///
/// Робокасса требует хранить именно историю, а не текущее состояние:
/// в споре о списании нужно показать, когда согласие было дано, какой
/// текст человек видел и когда он его отозвал. Поэтому строки только
/// добавляются — отзыв это новая запись с granted=false.
/// Согласие с юридическими документами (оферта, соглашение, политика,
/// согласие на обработку ПД): кто, когда, какой редакции, откуда.
model LegalConsent {
  id             String   @id @default(cuid())
  userId         String?
  email          String
  organizationId String?
  /// Редакция документов (LEGAL_VERSION).
  version        String
  /// Дословный текст рядом с галкой.
  statementText  String
  /// register | landing | update-modal
  source         String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email])
}

/// Личный QR-вход: скан → свой PIN → кабинет. Одна активная запись на
/// человека; перевыпуск отзывает старую (2026-09-22).
model PersonalLoginToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  createdById    String?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  lastUsedAt     DateTime?

  @@index([userId, revokedAt])
}

model PaymentConsent {
  id             String   @id @default(cuid())
  email          String
  /// Заказ, при оформлении которого дано согласие. Пусто у отзывов.
  orderId        Int?
  organizationId String?
  /// true — согласие дано, false — отозвано.
  granted        Boolean
  /// Дословный текст рядом с галочкой на момент согласия.
  statementText  String
  /// Редакция оферты, действовавшая в этот момент.
  offerRevision  String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([email, createdAt])
  @@index([organizationId])
}

// ==================== АССИСТЕНТ ====================

/// Настройки платформы, которые меняются без передеплоя.
///
/// Интеграция с ProjectsFlow настраивается управляющим платформы в
/// интерфейсе, а не переменными окружения: токен и проект меняются чаще,
/// чем выходит релиз, и держать их только в .env значит каждый раз
/// ходить на сервер.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Диалог с ассистентом. Один на пользователя в организации — человек,
/// вернувшийся через неделю, видит, о чём спрашивал, и не пересказывает
/// контекст заново.
model AssistantConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  title          String   @default("Новый диалог")
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  messages AssistantMessage[]

  @@index([organizationId])
  @@index([lastMessageAt])
}

/// Реплика диалога.
///
/// Ход ассистента заводится сразу в статусе pending с одноразовым
/// токеном: отвечает не сайт, а внешний исполнитель, и до его прихода
/// строка уже должна существовать — иначе ответ некуда положить.
model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role           String
  content        String
  /// "pending" | "done" | "error"
  status         String                @default("done")
  /// id задания в очереди ProjectsFlow. Карточек задач не заводим.
  pfJobId        String?
  /// sha256 одноразового токена хода: сам токен не хранится нигде.
  tokenHash      String?
  tokenExpiresAt DateTime?
  /// Когда исполнитель забрал контекст. Отличает «очередь пуста, никто
  /// не подхватил» от «работает, но долго».
  fetchedAt      DateTime?
  error          String?
  createdAt      DateTime              @default(now())

  @@index([conversationId])
  @@index([conversationId, status])
  @@index([status])
  @@index([createdAt])
}

// ==================== ПАРТНЁРЫ И WHITE-LABEL (B8) ====================

/// Партнёр — консультант / интегратор / сервис оборудования, который
/// приводит клиентов и сопровождает их. Спецификация задачи:
/// `.agent/tasks/partner-cabinet/spec.md`.
///
/// Жизненный цикл status:
///   pending   — заявка подана, ждёт ROOT
///   active    — одобрен, кабинет /partner открыт
///   rejected  — отклонён с комментарием (можно подать заново)
///   suspended — приостановлен ROOT: кабинет закрыт, начисления стоят
model Partner {
  id                      String              @id @default(cuid())
  /// Латинский slug из ссылки `wesetup.ru/p/<slug>`; резерв под
  /// `<slug>.wesetup.ru`. Выбирает партнёр при подаче заявки.
  slug                    String              @unique
  /// 6-символьный код для ввода клиентом в настройках.
  code                    String              @unique
  status                  String              @default("pending")
  /// consultant | integrator | equipment_service | other
  type                    String
  companyName             String
  inn                     String
  city                    String
  phone                   String
  telegram                String?
  contactEmail            String
  venuesCount             Int                 @default(0)
  termsAcceptedAt         DateTime
  /// Кто подал заявку и из какой организации — своя организация
  /// партнёра не может стать его клиентом.
  applicantUserId         String
  applicant               User                @relation("PartnerApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  applicantOrganizationId String?
  reviewComment           String?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  onboardingDoneAt        DateTime?
  /// ip | self_employed | company — реквизиты для выплат.
  payoutType              String?
  /// { fullName, inn, bank, bik, account, ... } — структура под тип,
  /// валидируется в API.
  payoutDetails           Json?
  agreementSignedAt       DateTime?
  agreementNumber         String?
  /// Партнёр выбрал «Не показывать клиентам информацию о консультанте»:
  /// клиенты видят нейтральную «Службу сопровождения WeSetup» — без бренда,
  /// контактов и упоминаний партнёрства (2026-09-22).
  hideFromClients         Boolean             @default(false)
  /// Версия принятого договора партнёра (`/partner-agreement`).
  agreementVersion        String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  members                 PartnerUser[]
  branding                PartnerBranding?
  clients                 PartnerClient[]
  invites                 PartnerInvite[]
  accruals                PartnerAccrual[]
  notes                   PartnerClientNote[]

  @@index([status])
  @@index([inn])
}

/// Люди партнёра. `owner` — подал заявку и управляет командой,
/// `member` — сотрудник партнёра с доступом к кабинету. Один человек —
/// не больше одного партнёра.
model PartnerUser {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation("PartnerMemberships", fields: [userId], references: [id], onDelete: Cascade)
  /// owner | member
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@index([partnerId])
}

/// Брендинг партнёра, применяется у всех его активных клиентов.
/// Логотипы лежат в БД (Bytes) и отдаются через
/// /api/partner-assets/<partnerId>/logo — один источник для сайта,
/// писем и PDF без файлового хранилища.
model PartnerBranding {
  partnerId       String   @id
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  brandName       String
  logoLight       Bytes?
  logoLightMime   String?
  logoDark        Bytes?
  logoDarkMime    String?
  /// Введённый HEX. Применяется только если проходит WCAG AA
  /// (см. checkAccent); иначе кабинет остаётся на стандартном индиго.
  accentColor     String?
  supportPhone    String?
  supportTelegram String?
  supportEmail    String?
  pdfSignature    String?
  loginGreeting   String?
  /// Растёт при каждой правке — cache-busting ссылок на лого.
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

/// Привязка клиента к партнёру. Одна активная (detachedAt IS NULL) на
/// организацию — частичный уникальный индекс создаётся в
/// ensurePartnerSchemaExtras(), Prisma такие не описывает. История
/// привязок остаётся навсегда.
model PartnerClient {
  id                  String              @id @default(cuid())
  partnerId           String
  partner             Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization        @relation("PartnerClients", fields: [organizationId], references: [id], onDelete: Cascade)
  /// view | edit — выбирает клиент.
  accessLevel         String              @default("view")
  /// link | code | invite | manual
  source              String              @default("link")
  attachedAt          DateTime            @default(now())
  detachedAt          DateTime?
  /// client | partner | admin
  detachedBy          String?
  /// «Показывать стандартный интерфейс WeSetup» — брендинг скрыт,
  /// привязка и начисления остаются.
  clientHidesBranding Boolean             @default(false)
  /// Первый оплаченный платёж клиента после привязки — от него
  /// считается окно 12 месяцев подписочного вознаграждения.
  firstPaymentAt      DateTime?
  createdAt           DateTime            @default(now())
  accruals            PartnerAccrual[]
  notes               PartnerClientNote[]

  @@index([organizationId, detachedAt])
  @@index([partnerId, detachedAt])
}

/// Заметки партнёра о клиенте — видны только партнёру.
model PartnerClientNote {
  id              String        @id @default(cuid())
  partnerId       String
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerClientId String
  partnerClient   PartnerClient @relation(fields: [partnerClientId], references: [id], onDelete: Cascade)
  authorUserId    String
  authorName      String
  text            String
  createdAt       DateTime      @default(now())

  @@index([partnerClientId, createdAt])
}

/// Email-приглашение клиента. status: sent | registered | declined.
model PartnerInvite {
  id                       String    @id @default(cuid())
  partnerId                String
  partner                  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email                    String
  /// sha256 токена из ссылки «Не интересно».
  tokenHash                String    @unique
  status                   String    @default("sent")
  sentAt                   DateTime  @default(now())
  registeredAt             DateTime?
  registeredOrganizationId String?
  declinedAt               DateTime?

  @@unique([partnerId, email])
  @@index([partnerId, status])
}

/// Правила вознаграждения — версионируются, старые начисления хранят
/// свою версию. Новая версия применяется только к новым начислениям.
model PartnerRewardRule {
  id                  String   @id @default(cuid())
  version             Int      @unique
  subscriptionPercent Decimal  @db.Decimal(5, 2)
  subscriptionMonths  Int
  hardwarePercent     Decimal  @db.Decimal(5, 2)
  bonusAmountRub      Decimal  @db.Decimal(10, 2)
  bonusAfterPayments  Int
  minPayoutRub        Decimal  @db.Decimal(10, 2)
  effectiveFrom       DateTime @default(now())
  createdByUserId     String?
  comment             String?
  createdAt           DateTime @default(now())
}

/// Начисление партнёру. kind: subscription | hardware | bonus |
/// subscription_reversal | hardware_reversal | bonus_reversal.
/// status: accrued → payable (закрытие месяца 1-го числа) → paid.
/// Уникальность (paymentOrderId, kind) — повторная обработка платежа
/// не создаёт дубль.
model PartnerAccrual {
  id              String        @id @default(cuid())
  partnerId       String
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerClientId String
  partnerClient   PartnerClient @relation(fields: [partnerClientId], references: [id], onDelete: Cascade)
  organizationId  String
  paymentOrderId  Int?
  paymentOrder    PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  kind            String
  baseAmountRub   Decimal       @db.Decimal(10, 2)
  ratePercent     Decimal?      @db.Decimal(5, 2)
  amountRub       Decimal       @db.Decimal(10, 2)
  status          String        @default("accrued")
  ruleVersion     Int
  /// "YYYY-MM" по Москве — месяц начисления для ведомости.
  periodMonth     String
  paidAt          DateTime?
  paidDocumentNo  String?
  reversalOfId    String?
  createdAt       DateTime      @default(now())

  @@unique([paymentOrderId, kind])
  @@index([partnerId, status])
  @@index([partnerId, periodMonth])
  @@index([organizationId])
}

/// Леджер баллов: строки только добавляются. Баланс — Organization.balanceRub,
/// меняется атомарно вместе со вставкой строки (src/lib/balance/ledger.ts).
model BalanceTransaction {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// + начисление, − списание.
  amount                 Int
  /// referral_reward | review_reward | order_spend | order_release | manual_adjust
  kind                   String
  description            String
  /// Идемпотентность одной колонкой (NULL для manual_adjust):
  /// "order_spend:123", "order_release:123", "referral_reward:<orgId>",
  /// "review_reward:<reviewId>".
  dedupeKey              String?      @unique
  paymentOrderId         Int?
  referredOrganizationId String?
  customerReviewId       String?
  actorUserId            String?
  createdAt              DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Лог отправленных приглашений (антиспам + список в кабинете).
/// Статус НЕ хранится — выводится при чтении: email → User → Organization
/// .referredByOrganizationId === наша → «зарегистрировался»; есть
/// BalanceTransaction referral_reward с этой организацией → «оплатил».
model ReferralInvite {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUserId String
  email           String
  createdAt       DateTime     @default(now())

  @@unique([organizationId, email])
}

/// Отзыв клиента за баллы. Тариф определяется по вложению, начисление —
/// после одобрения ROOT'ом (src/lib/balance/reviews.ts).
model CustomerReview {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String
  authorName        String
  place             String
  text              String
  /// text | photo | video — по вложению.
  kind              String
  mediaUrl          String?
  mediaMime         String?
  rating            Int?
  consentPublic     Boolean      @default(true)
  /// pending | approved | rejected
  status            String       @default("pending")
  rewardRub         Int          @default(0)
  rejectReason      String?
  showOnLanding     Boolean      @default(true)
  createdAt         DateTime     @default(now())
  moderatedAt       DateTime?
  moderatedByUserId String?

  @@index([organizationId])
  @@index([status, showOnLanding, createdAt])
}

/// Инцидент «температура вышла за норму» — одна запись на эпизод, а не
/// на каждое показание. Нужен затем, что раньше каждое out-of-range
/// показание слало новое сообщение всем управляющим: холодильник,
/// который греется час, давал десяток одинаковых пушей и ни одного
/// адресата, который обязан пойти и починить.
///
/// Жизненный цикл (src/lib/temperature-deviations.ts):
///   1. первое отклонение → инцидент + уведомление ОТВЕТСТВЕННОМУ за
///      журнал (JournalDocument.responsibleUserId);
///   2. повторные отклонения → только обновляем lastValue/lastSeenAt;
///   3. показание в норме ИЛИ вписан комментарий «что сделали» →
///      resolvedAt + сообщение «вернулось в норму»;
///   4. не исправлено за `Organization.deviationEscalationMinutes` →
///      escalatedAt + уведомление руководству (ровно один раз).
model TemperatureDeviationIncident {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Ключ объекта наблюдения: `equipment:<equipmentId>` для показаний с
  /// датчика/QR или `doc:<documentId>:<itemId>` для строки сеточного
  /// журнала. По нему ищем открытый инцидент, чтобы не плодить дубли.
  subjectKey        String
  /// Человекочитаемое имя холодильника — для текста уведомления.
  subjectName       String
  /// Equipment.id, если отклонение пришло от привязанного оборудования.
  equipmentId       String?
  /// Документ и элемент конфига, если отклонение из сеточного журнала.
  documentId        String?
  /// Кому ушло первое уведомление (ответственный за журнал). null —
  /// ответственного не нашли, сразу писали руководству.
  responsibleUserId String?
  /// Значение, с которого начался эпизод, и последнее показание.
  firstValue        Float
  lastValue         Float
  tempMin           Float?
  tempMax           Float?
  /// Когда ответственному ушло уведомление — точка отсчёта эскалации.
  notifiedAt        DateTime?
  /// Когда об инциденте сообщили руководству. Непустое = эскалация была.
  escalatedAt       DateTime?
  /// Когда температура вернулась в норму либо появился комментарий с
  /// корректирующим действием. Непустое = инцидент закрыт.
  resolvedAt        DateTime?
  /// Чем закрыт: `in_range` (вернулось в норму) или `correction`
  /// (ответственный вписал, что сделал).
  resolvedReason    String?
  lastSeenAt        DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, resolvedAt])
  @@index([subjectKey, resolvedAt])
}

/// Снимок первой страницы активного документа журнала — превью карточки
/// на дашборде и в списках вместо статичного образца. Рендерится cron'ом
/// (`/api/cron/journal-previews`) из того же PDF, что идёт на печать;
/// одна строка на (организация, код журнала), перерисовка перезаписывает.
model JournalPreview {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  documentId      String
  /// Точки (2026-09-05): "" — общее превью, иначе id точки: у каждой
  /// точки свой активный документ и свой снимок.
  buildingKey     String       @default("")
  png             Bytes
  width           Int
  height          Int
  /// `JournalDocument.updatedAt` на момент рендера — по нему cron понимает,
  /// что документ изменился и превью устарело.
  sourceUpdatedAt DateTime
  renderedAt      DateTime     @default(now())

  @@unique([organizationId, code, buildingKey])
  @@index([renderedAt])
}

// ────────────────────────────────────────────────────────────────────
// ФГИС «Меркурий» (ВетИС)
//
// Работа идёт через Ветис.API — SOAP-шлюз с ПСЕВДОАСИНХРОННЫМ
// протоколом: `submitApplicationRequest` возвращает id заявки, результат
// забирается отдельным `receiveApplicationResultRequest`. Поэтому здесь
// не «очередь мутаций», как у TasksFlow, а очередь ЗАЯВОК: и команды, и
// чтения проходят через один конечный автомат.
//
// Разделение учётных данных (отличается от TasksFlow):
//   • APIKey выдаётся ОДИН на информационную систему, то есть на весь
//     WeSetup — живёт в env, не в БД и не в UI;
//   • issuerGuid (ГУИД хозяйствующего субъекта) и логин уполномоченного
//     лица свои у каждой организации: это идентификаторы, не секреты.
// ────────────────────────────────────────────────────────────────────

enum MercuryOutboxStatus {
  pending
  submitted
  delivered
  failed
}

model MercuryIntegration {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "test" | "prod" — по нему выбирается baseUrl из env. Сам URL в БД не
  /// храним: иначе его можно подменить и увести запросы наружу.
  environment      String       @default("test")
  /// ГУИД хозяйствующего субъекта в Ветис (issuerId в запросах).
  issuerGuid       String
  /// Логин уполномоченного лица в Меркурии — от его имени гасятся ВСД.
  initiatorLogin   String
  /// Escape hatch для крупного клиента со СВОЕЙ зарегистрированной ИС.
  /// null — используется системный MERCURY_API_KEY. AES-256-GCM.
  apiKeyEncrypted  String?
  apiKeyPrefix     String?
  enabled          Boolean      @default(false)
  /// "off" | "assisted" | "auto_after_journal". По умолчанию assisted:
  /// система находит и заполняет, но гасит человек. См. docs/MERCURY.md.
  autoProcessMode  String       @default("assisted")
  /// Белый список поставщиков для auto_after_journal: массив ИНН.
  autoSupplierInns Json?
  /// Кому слать уведомления о новых и просроченных ВСД.
  notifyUserId     String?
  /// Верхняя граница уже вычитанного окна GetVetDocumentChangesList.
  changesCursorAt  DateTime?
  lastSyncAt       DateTime?
  lastSyncError    String?
  label            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  enterprises MercuryEnterprise[]
  documents   MercuryVetDocument[]
  outbox      MercuryOutbox[]

  @@index([enabled])
}

/// Площадка в Ветис ↔ точка WeSetup.
///
/// Отдельной таблицей, а не полем на Building: у сети одна точка может
/// иметь несколько площадок в Меркурии (склад и производство), а у
/// организации без точек Building может не быть вовсе.
model MercuryEnterprise {
  id                   String             @id @default(cuid())
  integrationId        String
  integration          MercuryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Точка WeSetup. null — организация ведёт журналы общим списком.
  buildingId           String?
  building             Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  /// В Ветис предприятие и площадка — разные сущности с разными ГУИДами.
  enterpriseGuid       String
  activityLocationGuid String?
  name                 String
  address              String?
  enabled              Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  documents MercuryVetDocument[]

  @@unique([integrationId, enterpriseGuid, activityLocationGuid])
  @@index([organizationId, enabled])
}

/// Входящий ветеринарный сопроводительный документ.
model MercuryVetDocument {
  id              String             @id @default(cuid())
  integrationId   String
  integration     MercuryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enterpriseId    String?
  enterprise      MercuryEnterprise? @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  /// Денормализация ради buildingWhere() — фильтра по точке.
  buildingId      String?
  /// UUID ВСД в Ветис — натуральный ключ. Пара (организация, uuid) и есть
  /// единственная настоящая защита от двойного гашения.
  uuid            String
  number          String?
  /// TRANSPORT | PRODUCTIVE | RETURNABLE
  docType         String?
  /// Статус в Ветис: CONFIRMED | UTILIZED | WITHDRAWN | ...
  remoteStatus    String
  /// Наш: new | acknowledged | processing | processed | process_failed | irrelevant
  localStatus     String             @default("new")
  issueDate       DateTime?
  deliveryDate    DateTime?
  /// Дедлайн гашения — один рабочий день, считается по производственному
  /// календарю РФ и таймзоне организации (src/lib/mercury/deadline.ts).
  processingDueAt DateTime?

  // Извлечённые поля для списка и маппинга в журнал приёмки.
  productName      String?
  productType      String?
  volume           Float?
  unit             String?
  batchNumber      String?
  productionDate   DateTime?
  expiryDate       DateTime?
  consignorName    String?
  consignorInn     String?
  manufacturerName String?
  transportInfo    String?
  accompanyingDocs String?
  /// Полный распарсенный документ: при смене маппинга можно перемолоть
  /// заново, не ходя в Меркурий.
  raw              Json

  // Результат гашения.
  processedAt     DateTime?
  processedById   String?
  processDecision String?
  processError    String?
  stockEntryGuid  String?

  // Связь с журналом приёмки и прослеживаемостью.
  journalDocumentId String?
  journalRowId      String?
  journalEntryId    String?
  batchKey          String?
  batchId           String?

  firstSeenAt  DateTime @default(now())
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outbox MercuryOutbox[]

  @@unique([organizationId, uuid])
  @@index([organizationId, localStatus, processingDueAt])
  @@index([organizationId, buildingId, localStatus])
  @@index([organizationId, batchKey])
}

/// Очередь заявок в Ветис.API.
model MercuryOutbox {
  id             String              @id @default(cuid())
  integrationId  String
  integration    MercuryIntegration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// UUID-v4, наш ключ идемпотентности.
  idempotencyKey String              @unique
  /// getVetDocumentList | getVetDocumentChangesList | getVetDocumentByUuid |
  /// processIncomingConsignment | getActivityLocationList
  action         String
  /// false для чтений — health-алерт смотрит только на команды, иначе он
  /// орал бы на застрявшем опросе справочников.
  isCommand      Boolean             @default(false)
  payload        Json
  status         MercuryOutboxStatus @default(pending)
  /// applicationId, выданный submitApplicationRequest.
  applicationId  String?
  /// Статус заявки в Ветис: ACCEPTED | IN_PROCESS | COMPLETED | REJECTED
  remoteStatus   String?
  submittedAt    DateTime?
  pollAttempts   Int                 @default(0)
  attempts       Int                 @default(0)
  lastAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  resultSummary  Json?
  vetDocumentId  String?
  vetDocument    MercuryVetDocument? @relation(fields: [vetDocumentId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([integrationId, status])
  @@index([organizationId, status, createdAt])
  @@index([applicationId])
}

/// Привязка устройства сотрудника: одноразовая ссылка, по которой он
/// задаёт себе пароль и сразу оказывается в кабинете.
///
/// Отличие от `EmployeeJoinToken`: тот СОЗДАЁТ нового сотрудника по
/// самозаписи, а этот выдаёт пароль СУЩЕСТВУЮЩЕМУ. На 2026-09-08 у 194
/// активных сотрудников пароля нет вовсе — их заводили импортом, через
/// Mini App или бота, а `src/lib/staff-create.ts` ставит пустой хеш,
/// то есть вход невозможен. Без этой модели они останутся заперты в
/// Telegram навсегда.
///
/// Форма скопирована с `BotInviteToken`: хранится только хеш, ссылка
/// одноразовая и с истечением.
model StaffPairToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Один активный токен на сотрудника: выдал новый — старый перестал
  /// действовать. Иначе по кухне гуляли бы несколько живых ссылок.
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

/// Подписка браузера на push-уведомления кабинета.
///
/// Подписок у человека несколько намеренно: личный телефон и общий
/// планшет кухни — разные устройства, и напоминание о незаполненном
/// журнале должно прийти на оба.
///
/// `endpoint` уникален ГЛОБАЛЬНО, а не в паре с пользователем: это
/// адрес, выданный пуш-сервисом конкретному браузеру. Если планшет
/// передали другому сотруднику и тот подписался, подписка должна
/// ПЕРЕЕХАТЬ на него, а не задвоиться — иначе прошлый владелец
/// продолжал бы получать чужие уведомления.
model WebPushSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String       @unique
  p256dh         String
  auth           String
  /// Чтобы показать человеку список его устройств.
  userAgent      String?
  /// Подряд идущие сбои. Мёртвую подписку пуш-сервис отдаёт как 404/410
  /// — такую удаляем сразу; счётчик нужен для остальных случаев.
  failureCount   Int          @default(0)
  lastSuccessAt  DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organizationId])
}

/// Закрывающий документ (УПД) по оплаченному заказу — снимок реквизитов
/// сторон и строк на момент выпуска. PDF рисуется из снимка, поэтому
/// смена реквизитов потом не меняет старые документы. Один на заказ.
model ClosingDocument {
  id             String    @id @default(cuid())
  orderId        Int       @unique
  organizationId String?
  /// Номер = номер заказа (InvId кассы) — уникален и уже виден клиенту.
  number         String
  /// Дата документа — дата оплаты (решение владельца 2026-09-09).
  issuedAt       DateTime
  seller         Json
  buyer          Json
  lines          Json
  totalRub       Decimal   @db.Decimal(10, 2)
  /// "none" — без НДС (УСН), статус УПД 2.
  vatMode        String    @default("none")
  /// issued | voided (возврат платежа).
  status         String    @default("issued")
  voidedAt       DateTime?
  /// Когда PDF ушёл письмом после оплаты.
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, issuedAt])
}

/// Промокод на скидку при оформлении подписки. Создаёт ROOT. Скидка
/// применяется к цене подписки (не к оборудованию), проверяется на сервере.
/// Использования считаются по оплаченным заказам — брошенный заказ лимит не ест.
model PromoCode {
  id             String    @id @default(cuid())
  /// В верхнем регистре, без пробелов.
  code           String    @unique
  /// "percent" | "fixed"
  kind           String
  /// Процент (1..100) или рубли.
  value          Int
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  /// null — без лимита.
  maxUses        Int?
  /// Только организациям без оплаченных заказов.
  newClientsOnly Boolean   @default(false)
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Журнал входов: когда, откуда и с какого устройства. Пишется при каждом
/// успешном входе (lib/login-trace.ts); «новое устройство» — новый ключ
/// устройства у этого человека после первого входа.
model LoginEvent {
  id          String   @id @default(cuid())
  userId      String
  at          DateTime @default(now())
  ip          String?
  userAgent   String?
  /// Человекочитаемо: «Chrome · Windows».
  device      String
  /// Хеш семейства браузер+ОС — версии не плодят «новые устройства».
  deviceKey   String
  /// password | phone | telegram | pair | register
  method      String
  isNewDevice Boolean  @default(false)

  @@index([userId, at])
  @@index([userId, deviceKey])
}

/// Код подтверждения входа: одноразовый, пять минут, пять попыток.
/// Хеш кода солится id челленджа (lib/login-challenge.ts).
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  /// password | phone
  method     String    @default("password")
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Идея клиента: площадка общая для всех организаций, автор виден только ROOT.
/// Статусы: new | planned | in_progress | done | declined (lib/ideas/rules.ts).
model Idea {
  id              String     @id @default(cuid())
  organizationId  String
  authorId        String
  title           String
  description     String?
  status          String     @default("new")
  /// Кэш числа голосов — держится в одной транзакции с IdeaVote.
  votes           Int        @default(0)
  /// Комментарий команды WeSetup, виден всем клиентам.
  adminNote       String?
  statusChangedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  voteRows        IdeaVote[]

  @@index([status, votes])
  @@index([organizationId, createdAt])
}

/// Один голос одного человека за идею.
model IdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
  @@index([userId])
}

/// Вход по ссылке из письма: хеш одноразового токена, 15 минут, один на пользователя.
model MagicLinkToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Замер доступности раз в 5 минут (крон uptime-sample) для страницы /status.
model UptimeSample {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  ok         Boolean
  dbMs       Int?
  telegramOk Boolean  @default(false)

  @@index([at])
}

/// Подписка организации на исходящие вебхуки (lib/webhooks).
model Webhook {
  id             String            @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[]          @default([])
  enabled        Boolean           @default(true)
  lastSuccessAt  DateTime?
  lastError      String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId])
}

/// Доставка одного события: очередь с повторами 1/5/30 минут.
model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  /// queued | sent | failed
  status        String    @default("queued")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastStatus    Int?
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
}

/// Ответ на вопрос NPS руководителя организации.
model NpsResponse {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  score          Int
  /// Шкала ответа: 5 — оценка 1–5 (с сентября 2026), 10 — старые ответы 0–10.
  /// Категории промоутер/критик считаются по своей шкале (src/lib/nps.ts).
  scale          Int      @default(10)
  comment        String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId])
}

/// Изданный приказ по организации.
///
/// Тело приказа НЕ храним: оно всегда пересобирается из шаблона
/// (`src/lib/orders/catalog.ts`) и `values`. Иначе правка формулировки
/// шаблона разошлась бы с тем, что лежит в реестре, и два приказа с
/// одним кодом печатались бы по-разному.
model CompanyOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Код шаблона из каталога: "haccp-responsible", "journals-intro", …
  templateCode   String
  /// Снимок названия на момент издания — шаблон могут переименовать.
  title          String
  /// Номер приказа как его ввёл человек: "12", "12-ОД".
  number         String
  issuedAt       DateTime
  /// Значения полей формы: { responsibleName: "Иванова О.П.", … }.
  values         Json
  /// Снимок реквизитов организации на момент издания. Без него
  /// перевыпуск после смены директора показал бы чужую подпись под
  /// старым приказом.
  orgSnapshot    Json
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, templateCode, number])
  @@index([organizationId, issuedAt])
}

/// Платная услуга каталога (настройка журналов, аудит, консультация).
///
/// Цена живёт в БД и правится ROOT'ом в /root/services — ровно как
/// `PlatformTariff`, чтобы смена прайса не требовала деплоя.
model PlatformService {
  /// Стабильный ключ, на который ссылается ServiceRequest.
  key         String   @id
  title       String
  /// Одна строка для карточки каталога.
  summary     String
  /// Подробное описание: что входит, как проходит, что на выходе.
  description String
  /// null = «цена по запросу». Вместе с priceFrom даёт три вида
  /// подписи: «5 000 ₽», «от 15 000 ₽», «по запросу».
  priceRub    Int?
  priceFrom   Boolean  @default(true)
  /// "за услугу" | "в месяц" | "за час" — приписка справа от цены.
  unit        String?
  /// "setup" | "consult" | "audit" | "docs"
  category    String
  active      Boolean  @default(true)
  sort        Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Заявка на платную услугу.
///
/// Поля контактов повторяют `FeedbackReport`: форма на публичном сайте
/// и форма в кабинете пишут одинаково, а ROOT разбирает их одним
/// списком в /root/service-requests.
model ServiceRequest {
  id                String    @id @default(cuid())
  serviceKey        String
  /// Снимок названия услуги: каталог могут переименовать.
  serviceTitle      String
  organizationId    String?
  organizationName  String?
  userId            String?
  contactName       String
  contactPhone      String
  contactEmail      String?
  comment           String?
  /// "new" | "in_progress" | "done" | "cancelled"
  status            String    @default("new")
  /// Сколько списано с баланса при оформлении. 0 — заявка без оплаты
  /// (цена «от» / «по запросу» либо баланса не хватило).
  paidRub           Int       @default(0)
  /// "app" — из кабинета, "site" — с публичной страницы /uslugi.
  source            String    @default("app")
  /// Когда админ-уведомление реально ушло. null = канал промолчал —
  /// это видно в /root/service-requests, а не только в console.error.
  adminTgNotifiedAt DateTime?
  adminEmailedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

/// Свой шаблон колонок журнала (бракеражи): набор скрытых/переименованных/своих
/// колонок и их порядок. Встроенные шаблоны («Рекомендуемая форма…») живут в
/// коде, см. src/lib/journal-column-templates.ts.
model JournalColumnTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalCode    String
  name           String
  /// JournalColumnsConfig: { hidden, labels, custom?, mustFill?, order? }.
  columns        Json
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, journalCode])
}

/// Списки мастер-кабинета справочников: меню (для бракеража готовой
/// продукции) и сырьё (для бракеража скоропорта). Раздаются всем
/// организациям пула служебного кода (src/lib/master-directory-push.ts).
model SharedDirectoryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// "dish" — меню для БЖГП; "product" — сырьё для скоропорта
  kind           String
  name           String
  supplier       String?
  manufacturer   String?
  /// Меню: выход, как ввели («200», «200/10», «1 шт.»).
  portion        String?
  /// Меню: время изготовления «HH:MM».
  time           String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, kind])
}

/// Скан приказа к журналу организации (2026-09-24, пожелание РПН):
/// приказ о назначении ответственного за гигиенический журнал, о
/// бракеражной комиссии и т. п. Привязка — организация + код журнала, а
/// не документ периода: приказ действует, пока его не заменят, и идёт со
/// всеми документами журнала (просмотр, проверяющий, печать после страниц
/// журнала). Файл — в БД (Bytes), как логотипы партнёров: отдаётся только
/// через API с проверкой организации, прямой публичной ссылки нет.
model JournalOrderScan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalCode    String
  /// Название приказа; по умолчанию — имя файла без расширения.
  title          String
  fileName       String
  /// application/pdf | image/jpeg | image/png
  mimeType       String
  sizeBytes      Int
  content        Bytes
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, journalCode, createdAt])
}
