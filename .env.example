DATABASE_URL="postgresql://user:password@localhost:5432/haccp_online"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Source-site scraping (legacy import)
SOURCE_SITE_LOGIN_URL="https://lk.haccp-online.ru/docs/login"
SOURCE_SITE_START_URL="https://lk.haccp-online.ru/docs/1"
SOURCE_SITE_USERNAME=""
SOURCE_SITE_PASSWORD=""

# Telegram integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_LINK_TOKEN_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_LOG_RETENTION_DAYS="30"
# Optional — in regions where api.telegram.org is blocked (RU), set this to a
# reverse-proxy URL (e.g. Cloudflare Worker that forwards /bot*/* → telegram).
# Example: https://tg-proxy.<you>.workers.dev   (no trailing /)
TELEGRAM_API_ROOT=""
# Optional — bypass Roskomnadzor's selective IP-level null-routing by pinning
# api.telegram.org to an IPv4 that still answers (e.g. 149.154.167.220 at the
# time of writing). TLS SNI stays api.telegram.org so the cert validates.
# Verify with: curl --resolve api.telegram.org:443:<IP> https://api.telegram.org/bot<TOKEN>/getMe
TELEGRAM_FORCE_IP=""

# Канал новых статей блога в Telegram (числовой id или @username). Пусто — автопост выключен.
TELEGRAM_BLOG_CHANNEL_ID=
# MAX в окне «Свяжитесь с нами» (только https://max.ru/…). Переменная сборки:
# после изменения нужна выкладка. Пусто — строки MAX в окне нет.
NEXT_PUBLIC_WESETUP_MAX_URL=

# Email (Resend / SMTP)
RESEND_API_KEY=""
SMTP_FROM=""

# Platform ROOT superadmin bootstrap (seeded by prisma/seed.ts).
# Set PLATFORM_ORG_ID once; changing it after first seed orphans the old row.
# Use ROOT_PASSWORD (plain) — .env parsing (dotenv / Next.js @next/env)
# interprets `$` characters, which mangles a bcrypt hash like $2b$12$...
# into an unusable string. Plain password is hashed by seed.ts itself.
PLATFORM_ORG_ID="platform"
ROOT_EMAIL=""
ROOT_PASSWORD=""
# Only use ROOT_PASSWORD_HASH if you know your env loader does NOT interpolate
# `$` sequences. Most (dotenv-expand, @next/env) do — stick with ROOT_PASSWORD.
ROOT_PASSWORD_HASH=""

# Registration wizard rate limit + email verification
EMAIL_VERIFICATION_TTL_MIN="10"
REGISTER_RATE_LIMIT="5"

# --- Робокасса (приём оплаты подписки) -------------------------------
# Значения берутся в кабинете магазина. Пароль #1 подписывает запрос
# оплаты, Пароль #2 — серверное уведомление на /payment, Пароль #3
# нужен только XML/JWT-сервисам и в этом флоу не используется.
ROBOKASSA_MERCHANT_LOGIN=""
ROBOKASSA_PASSWORD1=""
ROBOKASSA_PASSWORD2=""
ROBOKASSA_PASSWORD3=""
# Отдельная пара паролей для тестового режима.
ROBOKASSA_TEST_PASSWORD1=""
ROBOKASSA_TEST_PASSWORD2=""
# 1 — платежи идут в тестовом режиме (деньги не списываются).
ROBOKASSA_IS_TEST="1"
# 1 — передавать Receipt (фискализация). Включать, только если у
# магазина подключены Робочеки, иначе Робокасса отвергнет подпись.
ROBOKASSA_SEND_RECEIPT="0"
# Куда слать уведомление о новой оплате (chat_id владельца в Telegram).
PLATFORM_ADMIN_TELEGRAM_CHAT_ID=""

# DaData: подсказки по ИНН в анкете и настройках организации
DADATA_API_KEY=

# ── ФГИС «Меркурий» (ВетИС) ──────────────────────────────────────────
# APIKey выдаётся ОДИН на информационную систему, то есть на весь
# WeSetup, а не на клиента. Клиенту принадлежат issuerGuid и логин
# уполномоченного лица — они лежат в БД, потому что это идентификаторы,
# а не секреты. Подробности: docs/MERCURY.md
#
# Пока MERCURY_API_KEY пуст, интеграция работает в ДЕМО-РЕЖИМЕ на
# учебных данных, и интерфейс честно пишет об этом крупной плашкой.
MERCURY_API_KEY=
# Сервисная учётка шлюза, если Ветис.API её потребует (HTTP Basic).
MERCURY_SERVICE_LOGIN=
MERCURY_SERVICE_PASSWORD=
# test — api2.vetrf.ru:8002, prod — api.vetrf.ru. Базовый URL берётся из
# кода (src/lib/mercury/ns.ts), а не из БД: подменив его, можно увести
# запросы вместе с ключом на чужой хост.
MERCURY_ENV="test"
# Версия схемы Ветис.API. 2.1 в проде, 3.0 в пилоте.
MERCURY_API_VERSION="2.1"
# Только для разработки: полный адрес мок-шлюза вместо настоящего.
#   MERCURY_MODE=live
#   MERCURY_BASE_URL="http://localhost:3000/api/dev/mercury-mock"
#   LOCAL_INTEGRATIONS_ALLOWED=1
MERCURY_MODE=
MERCURY_BASE_URL=

# --- Push-уведомления в установленном приложении (docs/PWA.md) ---
# Одна пара ключей на платформу. Сгенерировать:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Пока ключи не заданы, раздел «Уведомления на телефон» в кабинете просто
# не показывается, а отправка — no-op. Это сознательно: отсутствие
# настройки на сервере не должно ронять запросы.
#
# МЕНЯТЬ КЛЮЧИ ПОСЛЕ ЗАПУСКА НЕЛЬЗЯ: подписки браузеров привязаны к
# публичному ключу, и после смены все они перестанут работать молча —
# людям придётся включать уведомления заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для пуш-сервиса (требование RFC 8292): по нему с нами свяжутся,
# если с отправителя пойдёт спам.
VAPID_SUBJECT="mailto:noreply@wesetup.ru"

# Topvisor — семантика и позиции wesetup.ru под ROOT (/root/seo/positions).
# User-Id обязателен как отдельный заголовок: без него API отвечает
# «Header 'User-Id' is missing» даже с верным ключом.
# PROJECT_ID — проект в Topvisor; смена проекта не требует правки кода.
# Без этих переменных страница показывает заглушку, а не падает.
TOPVISOR_API_KEY=
TOPVISOR_USER_ID=
TOPVISOR_PROJECT_ID=
# Registration anti-bot protection (required before enabling public signup).
# Runtime settings; the public endpoint only returns the client key.
# Create a dedicated Google reCAPTCHA v2 Checkbox key pair.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_HOSTNAMES="wesetup.ru,www.wesetup.ru"
