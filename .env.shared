# ============================================================
# HACCP-Online — shared secrets for all developers
# Скопируй в .env: cp .env.shared .env
# ============================================================

# === ЛОКАЛЬНАЯ РАЗРАБОТКА ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/haccp_online?sslmode=disable"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-prod-32chars!!"

# === ПРОДАКШН СЕРВЕР ===
# Хостинг: FastPanel, Ubuntu 24.04, Azure
# Приложение: ~/www/haccp.magday.ru/app (PM2, port 3001)
# Домен: https://haccp.magday.ru
#
# Продакшн .env настраивается на сервере вручную.
# SSH и DB креденшалы хранятся отдельно (не в репозитории).

# === TUYA IOT (общие для дев и прод) ===
TUYA_ACCESS_ID=""
TUYA_ACCESS_SECRET=""
TUYA_BASE_URL="https://openapi.tuyaeu.com"
TUYA_CRON_SECRET=""
# Датчик: bf397860f79b0963a0nakc (модель SNT957W-DE, WiFi, temp+humidity)

# === AI / OCR ===
# Ключ языковой модели сайту не нужен: все AI-задания, включая распознавание
# фото (этикетки, показания дисплеев, «С фото»), выполняет диспетчер
# ProjectsFlow — см. docs/ai-dispatcher.md. Для проверки распознавания без
# очереди (только вне прода): WESETUP_VISION_MOCK_REPLY или WESETUP_VISION_MOCK_FILE.

# === TELEGRAM ===
# Бот: @wesetupbot
# Webhook: https://haccp.magday.ru/api/notifications/telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="wesetupbot"
TELEGRAM_WEBHOOK_SECRET=""

# === CRON (для ежедневной проверки заполнения журналов) ===
CRON_SECRET=""

# === SMTP (для прод — localhost:25, для дев — оставь пустым) ===
SMTP_HOST=""
SMTP_PORT=""
SMTP_FROM=""

# DaData: подсказки по ИНН в анкете и настройках организации
DADATA_API_KEY=

# === ПРИЛОЖЕНИЯ ANDROID И iOS ===
# JSON сервисного аккаунта Firebase для push в приложения (одной строкой); пусто - push в приложения выключен
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Минимальная версия приложения (например 1.0.0); ниже - экран «Обновите приложение»; пусто - без проверки
MOBILE_APP_MIN_VERSION=""
# Числовой id приложения в App Store для ссылки «Обновить»
APPLE_APP_ID=""
# Team ID аккаунта Apple Developer для универсальных ссылок (/.well-known/apple-app-site-association)
APPLE_TEAM_ID=""
# Отпечатки SHA-256 ключей подписи Android через запятую (/.well-known/assetlinks.json)
ANDROID_CERT_SHA256=""
