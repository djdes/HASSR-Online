#!/usr/bin/env sh
# pre-commit: быстрые проверки (секунды, не минуты).
# Полный type-check и все тесты гоняет CI перед деплоем (.github/workflows/deploy.yml,
# job «gate»): без него прод не обновится. Локально — только секреты и тесты,
# которые лежат рядом с изменёнными файлами (foo.ts → foo.test.ts).

echo "→ Проверка на секреты..."
sh scripts/check-secrets.sh || exit 1

sh scripts/test-related.sh || {
  echo "✗ Упал тест рядом с изменённым файлом. Почините или пропустите hook через --no-verify."
  exit 1
}

echo "✓ pre-commit OK"
