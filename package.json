{
  "name": "haccp-online",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "i18n:types": "node scripts/i18n-types.mjs",
    "i18n:check": "node scripts/i18n-types.mjs --check && node --import tsx --test src/i18n/*.test.ts",
    "i18n:inventory": "tsx scripts/i18n-inventory.ts",
    "seo:indexnow": "node scripts/submit-indexnow.mjs --strict",
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:bot": "tsx scripts/test-bot-wizard.ts",
    "setup:telegram-bot": "tsx scripts/setup-telegram-bot.ts",
    "deploy:manual": "bash scripts/deploy.sh",
    "backfill:journal-staff": "tsx scripts/backfill-journal-staff-bindings.ts",
    "audit:source:parity": "tsx scripts/audit-source-local-parity.ts",
    "seed:haccp-demo": "tsx prisma/seed-haccp-demo.ts",
    "reset:demo:journals": "tsx scripts/reset-demo-journal-data.ts",
    "watch:progress": "powershell -ExecutionPolicy Bypass -File scripts/watch-progress.ps1",
    "capture:source:25-27": "tsx scripts/capture-source-journals.ts --targets tmp-source-journals/targets-25-27.json --out tmp-source-journals/capture-25-27",
    "capture:source:25-27:auto": "tsx scripts/capture-source-journals.ts --no-login-pause --targets tmp-source-journals/targets-25-27.json --out tmp-source-journals/capture-25-27",
    "capture:source:all": "tsx scripts/crawl-all-source-journals.ts",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit --skipLibCheck --incremental --tsBuildInfoFile tsconfig.typecheck.tsbuildinfo -p tsconfig.typecheck.json",
    "video:render": "tsx scripts/landing-video/render.ts",
    "video:render:autofill": "tsx scripts/landing-video/render-autofill.ts",
    "video:render:clips": "tsx scripts/landing-video/render-clips.ts",
    "test": "node --import tsx --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --watch --test \"src/**/*.test.ts\"",
    "test:ci": "node --import tsx --test --test-reporter=tap \"src/**/*.test.ts\"",
    "test:changed": "node scripts/test-changed.mjs",
    "test:gate": "bash scripts/test-with-baseline.sh",
    "test:gate:full": "TEST_FULL=1 bash scripts/test-with-baseline.sh",
    "verify": "bash scripts/verify-before-push.sh",
    "qa:smoke:prod": "bash .agent/smoke-prod.sh",
    "qa:complete-tasks": "bash .agent/complete-all.sh",
    "qa:fill-remaining": "bash .agent/fill-remaining.sh",
    "prepare": "if [ -d .git ]; then chmod +x .husky/pre-commit .husky/pre-push 2>/dev/null || true; git config core.hooksPath .husky 2>/dev/null || true; fi"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@remotion/player": "4.0.528",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tuya/tuya-connector-nodejs": "^2.1.2",
    "@types/qrcode": "^1.5.6",
    "api-anything": "^0.3.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "grammy": "^1.46.0",
    "html5-qrcode": "^2.3.8",
    "imapflow": "^2.11.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "mailparser": "^3.14.2",
    "modern-screenshot": "^4.7.0",
    "mysql2": "3.24.6",
    "next": "16.1.6",
    "next-auth": "^4.24.15",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "node-html-parser": "9.0.7",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "remotion": "4.0.528",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "telegram": "2.26.22",
    "undici": "^8.1.0",
    "use-intl": "4.14.9",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "^1.65.0",
    "@remotion/bundler": "4.0.528",
    "@remotion/cli": "4.0.528",
    "@remotion/renderer": "4.0.528",
    "@remotion/tailwind-v4": "4.0.528",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsqr": "^1.4.0",
    "playwright": "^1.59.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
