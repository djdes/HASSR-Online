<?xml version="1.0" encoding="utf-8"?>
<!--
  Вариант для Google Play: приложение обновляет магазин. Самообновление
  с сайта Play запрещает (политика «Злоупотребление устройствами и сетью»),
  поэтому разрешение на установку пакетов, фоновое задание проверки и приёмник
  результата установки из итогового манифеста убираются.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application>
        <service
            android:name=".update.UpdateJobService"
            tools:node="remove" />
        <receiver
            android:name=".update.UpdateStatusReceiver"
            tools:node="remove" />
    </application>
</manifest>
