<?xml version="1.0" encoding="utf-8"?>
<!-- Ключ входа зашифрован ключом Android Keystore, который не переносится на
     другой телефон, — переносить данные приложения бессмысленно. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
