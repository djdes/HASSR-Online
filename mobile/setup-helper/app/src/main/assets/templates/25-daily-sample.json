{
  "id": "daily-sample",
  "title": "Суточная проба",
  "description": "Проба блюда: приём пищи, когда отобрана и до какого времени хранить (48 часов при +2…+6 °C).",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "dish", "label": "Блюдо", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Суп куриный с лапшой»", "source": "dishes"},
    {"key": "meal", "label": "Приём пищи", "type": "text", "default": "Обед", "maxLength": 20, "options": ["Завтрак", "Второй завтрак", "Обед", "Полдник", "Ужин", "Второй ужин"]},
    {"key": "sampledAt", "label": "Отобрано", "type": "datetime", "default": "now"},
    {"key": "keepFor", "label": "Хранить", "type": "duration", "default": "48h", "options": ["48h", "72h"]},
    {"key": "employee", "label": "Отобрал", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "dish", "start": "sampledAt", "until": "sampledAt+keepFor", "untilLabel": "Хранить до", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "СУТОЧНАЯ ПРОБА", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{dish}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 3.9, "text": "Приём пищи: {{meal}}", "size": 2.8, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 25.9, "w": 53.2, "h": 4.6, "text": "Хранить до: {{sampledAt+keepFor|datetime}}", "size": 3.3, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 53.2, "h": 3.7, "text": "Отобрано: {{sampledAt|datetime}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 29.4, "h": 3.7, "text": "Отобрал: {{employee}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 32.2, "y": 34.4, "w": 23.4, "h": 3.7, "text": "Хранение: +2…+6 °C", "size": 2.7, "align": "right", "maxLines": 1}
  ]
}
