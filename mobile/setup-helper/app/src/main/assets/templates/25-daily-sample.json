{
  "id": "daily-sample",
  "title": "Суточная проба",
  "description": "Проба блюда: приём пищи, когда отобрана и до какого времени хранить (48 часов при +2…+6 °C).",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "dish", "label": "Блюдо", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Суп куриный с лапшой»"},
    {"key": "meal", "label": "Приём пищи", "type": "text", "default": "Обед", "maxLength": 20, "options": ["Завтрак", "Второй завтрак", "Обед", "Полдник", "Ужин", "Второй ужин"]},
    {"key": "sampledAt", "label": "Отобрано", "type": "datetime", "default": "now"},
    {"key": "keepFor", "label": "Хранить", "type": "duration", "default": "48h", "options": ["48h", "72h"]},
    {"key": "employee", "label": "Отобрал", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    {"type": "text", "x": 1.5, "y": 1.2, "w": 55, "h": 5.4, "text": "СУТОЧНАЯ ПРОБА", "size": 3.4, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2, "y": 7, "w": 54, "h": 8.8, "text": "{{dish}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    {"type": "line", "x": 2, "y": 16.3, "x2": 56, "y2": 16.3, "thickness": 0.3},
    {"type": "text", "x": 2, "y": 16.9, "w": 54, "h": 4.4, "text": "Приём пищи: {{meal}}", "size": 3, "maxLines": 1},
    {"type": "text", "x": 2, "y": 21.5, "w": 54, "h": 5, "text": "Хранить до: {{sampledAt+keepFor|datetime}}", "size": 3.5, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2, "y": 26.8, "w": 54, "h": 4.2, "text": "Отобрано: {{sampledAt|datetime}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 31.2, "w": 54, "h": 4.2, "text": "Отобрал: {{employee}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 35.6, "w": 36, "h": 3.8, "text": "Хранение: +2…+6 °C", "size": 2.6, "maxLines": 1},
    {"type": "text", "x": 39, "y": 35.6, "w": 17, "h": 3.8, "text": "{{org.name}}", "size": 2.6, "align": "right", "maxLines": 1}
  ]
}
