{
  "id": "product",
  "title": "Маркировка продукта",
  "description": "Название, когда изготовлено, до какого времени годно и кто отвечает.",
  "size": { "width": 58, "height": 40 },
  "fields": [
    { "key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Салат Цезарь»" },
    { "key": "madeAt", "label": "Изготовлено", "type": "datetime", "default": "now" },
    { "key": "shelfLife", "label": "Срок годности", "type": "duration", "default": "24h", "options": ["2h", "6h", "12h", "24h", "36h", "48h", "72h", "5d", "7d"] },
    { "key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40 }
  ],
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.6, "w": 53.2, "h": 10, "text": "{{product}}", "size": 5, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 19.0, "x2": 55.6, "y2": 19.0, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 19.4, "w": 53.2, "h": 4.4, "text": "Изготовлено: {{madeAt|datetime}}", "size": 3.2, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 24.0, "w": 53.2, "h": 5.2, "text": "Годен до: {{madeAt+shelfLife|datetime}}", "size": 3.8, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 29.4, "w": 53.2, "h": 3.9, "text": "Срок: {{shelfLife}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 33.6, "w": 53.2, "h": 3.9, "text": "Отв.: {{employee}}", "size": 2.9, "maxLines": 1}
  ]
}
