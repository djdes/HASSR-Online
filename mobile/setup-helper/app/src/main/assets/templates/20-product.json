{
  "id": "product",
  "title": "Маркировка продукта",
  "description": "Название, когда изготовлено, до какого времени годно и кто отвечает.",
  "size": { "width": 58, "height": 40 },
  "fields": [
    { "key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Салат Цезарь»" },
    { "key": "madeAt", "label": "Изготовлено", "type": "datetime", "default": "now" },
    { "key": "shelfLife", "label": "Срок годности", "type": "duration", "default": "24h", "options": ["2h", "6h", "12h", "24h", "36h", "48h", "72h", "5d", "7d"] },
    { "key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40 }
  ],
  "elements": [
    { "type": "text", "x": 2, "y": 1.5, "w": 54, "h": 11, "text": "{{product}}", "size": 5.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2 },
    { "type": "line", "x": 2, "y": 13.2, "x2": 56, "y2": 13.2, "thickness": 0.3 },
    { "type": "text", "x": 2, "y": 14.4, "w": 54, "h": 4.8, "text": "Изготовлено: {{madeAt|datetime}}", "size": 3.3, "maxLines": 1 },
    { "type": "text", "x": 2, "y": 19.6, "w": 54, "h": 5.8, "text": "Годен до: {{madeAt+shelfLife|datetime}}", "size": 3.9, "bold": true, "maxLines": 1 },
    { "type": "text", "x": 2, "y": 25.8, "w": 54, "h": 4.2, "text": "Срок: {{shelfLife}}", "size": 3, "maxLines": 1 },
    { "type": "text", "x": 2, "y": 30.2, "w": 54, "h": 4.4, "text": "Отв.: {{employee}}", "size": 3, "maxLines": 1 },
    { "type": "text", "x": 2, "y": 34.8, "w": 54, "h": 4, "text": "{{org.name}}", "size": 2.7, "align": "right", "maxLines": 1 }
  ]
}
