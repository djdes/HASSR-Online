{
  "id": "opened",
  "title": "Вскрытая упаковка",
  "description": "Когда вскрыли и до какого времени использовать.",
  "size": { "width": 58, "height": 40 },
  "fields": [
    { "key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Сливки 33%»", "source": "products" },
    { "key": "openedAt", "label": "Вскрыто", "type": "datetime", "default": "now" },
    { "key": "useWithin", "label": "Использовать в течение", "type": "duration", "default": "24h", "options": ["6h", "12h", "24h", "48h", "72h", "5d"] },
    { "key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff" }
  ],
  "record": {"item": "product", "start": "openedAt", "until": "openedAt+useWithin", "untilLabel": "Использовать до", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "ВСКРЫТАЯ УПАКОВКА", "size": 3.3, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 22.0, "w": 53.2, "h": 4.0, "text": "Вскрыто: {{openedAt|datetime}}", "size": 3.0, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 26.4, "w": 53.2, "h": 4.8, "text": "Использовать до: {{openedAt+useWithin|datetime}}", "size": 3.4, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 31.6, "w": 53.2, "h": 4.2, "text": "Отв.: {{employee}}", "size": 3.0, "maxLines": 1}
  ]
}
