{
  "id": "reject",
  "title": "Брак — не использовать",
  "description": "Продукт, который нельзя использовать: причина, когда и кто отметил.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Сметана 20%»", "source": "products"},
    {"key": "reason", "label": "Причина", "type": "text", "required": true, "default": "Истёк срок годности", "maxLength": 50, "options": ["Истёк срок годности", "Нарушены условия хранения", "Повреждена упаковка", "Не соответствует по качеству", "Нет маркировки", "Возврат поставщику"]},
    {"key": "markedAt", "label": "Отмечено", "type": "datetime", "default": "now"},
    {"key": "employee", "label": "Отметил", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "product", "start": "markedAt", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "БРАК · НЕ ИСПОЛЬЗОВАТЬ", "size": 3.3, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 8.2, "text": "Причина: {{reason}}", "size": 3.2, "bold": true, "valign": "center", "maxLines": 2},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 53.2, "h": 3.7, "text": "Отмечено: {{markedAt|datetime}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 53.2, "h": 3.7, "text": "Отметил: {{employee}}", "size": 2.7, "maxLines": 1}
  ]
}
