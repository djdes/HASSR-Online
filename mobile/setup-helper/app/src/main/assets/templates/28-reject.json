{
  "id": "reject",
  "title": "Брак — не использовать",
  "description": "Продукт, который нельзя использовать: причина, когда и кто отметил.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Сметана 20%»"},
    {"key": "reason", "label": "Причина", "type": "text", "required": true, "default": "Истёк срок годности", "maxLength": 50, "options": ["Истёк срок годности", "Нарушены условия хранения", "Повреждена упаковка", "Не соответствует по качеству", "Нет маркировки", "Возврат поставщику"]},
    {"key": "markedAt", "label": "Отмечено", "type": "datetime", "default": "now"},
    {"key": "employee", "label": "Отметил", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    {"type": "text", "x": 1.5, "y": 1.2, "w": 55, "h": 5.4, "text": "БРАК · НЕ ИСПОЛЬЗОВАТЬ", "size": 3.6, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2, "y": 7, "w": 54, "h": 8.8, "text": "{{product}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    {"type": "line", "x": 2, "y": 16.3, "x2": 56, "y2": 16.3, "thickness": 0.3},
    {"type": "text", "x": 2, "y": 16.9, "w": 54, "h": 9.4, "text": "Причина: {{reason}}", "size": 3.3, "bold": true, "valign": "center", "maxLines": 2},
    {"type": "text", "x": 2, "y": 26.8, "w": 54, "h": 4.2, "text": "Отмечено: {{markedAt|datetime}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 31.2, "w": 54, "h": 4.2, "text": "Отметил: {{employee}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 35.6, "w": 54, "h": 3.8, "text": "{{org.name}}", "size": 2.6, "align": "right", "maxLines": 1}
  ]
}
