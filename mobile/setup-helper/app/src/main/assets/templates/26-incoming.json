{
  "id": "incoming",
  "title": "Приёмка сырья",
  "description": "Сырьё и продукты при поступлении: поставщик, партия, срок годности по документам.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Молоко 3,2%»", "source": "products"},
    {"key": "supplier", "label": "Поставщик", "type": "text", "maxLength": 40, "hint": "Например, ООО «Агро»", "source": "suppliers", "fillFrom": "supplier"},
    {"key": "batch", "label": "Партия или № документа", "type": "text", "maxLength": 30},
    {"key": "receivedAt", "label": "Поступило", "type": "datetime", "default": "now", "dateOnly": true},
    {"key": "expiresAt", "label": "Годен до (по документам)", "type": "datetime", "default": "now+3d", "dateOnly": true},
    {"key": "storage", "label": "Условия хранения", "type": "text", "default": "+2…+6 °C", "maxLength": 30, "options": ["+2…+6 °C", "0…+4 °C", "−18 °C и ниже", "Не выше +25 °C"], "fillFrom": "storage"},
    {"key": "employee", "label": "Принял", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "product", "start": "receivedAt", "until": "expiresAt", "untilLabel": "Годен до", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "ПРИЁМКА", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 3.9, "text": "Поставщик: {{supplier}}", "size": 2.8, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 25.9, "w": 53.2, "h": 4.6, "text": "Годен до: {{expiresAt|date}}", "size": 3.3, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 26, "h": 3.7, "text": "Партия: {{batch}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 29, "y": 30.6, "w": 26.6, "h": 3.7, "text": "Принял: {{employee}}", "size": 2.7, "align": "right", "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 53.2, "h": 3.7, "text": "Поступило: {{receivedAt|date}} · {{storage}}", "size": 2.7, "maxLines": 1}
  ]
}
