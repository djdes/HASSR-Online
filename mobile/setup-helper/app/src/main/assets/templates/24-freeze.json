{
  "id": "freeze",
  "title": "Заморозка",
  "description": "Продукт или заготовка в морозильнике: когда заморозили и до какого числа хранить.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Фарш говяжий»"},
    {"key": "frozenAt", "label": "Заморожено", "type": "datetime", "default": "now", "dateOnly": true},
    {"key": "storeFor", "label": "Срок хранения", "type": "duration", "default": "30d", "options": ["7d", "14d", "30d", "60d", "90d", "180d"]},
    {"key": "storage", "label": "Условия хранения", "type": "text", "default": "−18 °C и ниже", "maxLength": 30, "options": ["−18 °C и ниже", "−12 °C и ниже", "−24 °C и ниже"]},
    {"key": "amount", "label": "Количество или масса", "type": "text", "maxLength": 16, "hint": "Например, 1 кг"},
    {"key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    {"type": "text", "x": 1.5, "y": 1.2, "w": 55, "h": 5.4, "text": "ЗАМОРОЖЕНО", "size": 3.4, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2, "y": 7, "w": 54, "h": 8.8, "text": "{{product}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    {"type": "line", "x": 2, "y": 16.3, "x2": 56, "y2": 16.3, "thickness": 0.3},
    {"type": "text", "x": 2, "y": 16.9, "w": 54, "h": 4.4, "text": "Заморожено: {{frozenAt|date}}", "size": 3, "maxLines": 1},
    {"type": "text", "x": 2, "y": 21.5, "w": 54, "h": 5, "text": "Хранить до: {{frozenAt+storeFor|date}}", "size": 3.5, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2, "y": 26.8, "w": 38, "h": 4.2, "text": "Хранение: {{storage}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 41, "y": 26.8, "w": 15, "h": 4.2, "text": "{{amount}}", "size": 2.9, "bold": true, "align": "right", "maxLines": 1},
    {"type": "text", "x": 2, "y": 31.2, "w": 54, "h": 4.2, "text": "Отв.: {{employee}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 35.6, "w": 54, "h": 3.8, "text": "{{org.name}}", "size": 2.6, "align": "right", "maxLines": 1}
  ]
}
