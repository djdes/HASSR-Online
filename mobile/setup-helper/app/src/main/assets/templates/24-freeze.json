{
  "id": "freeze",
  "title": "Заморозка",
  "description": "Продукт или заготовка в морозильнике: когда заморозили и до какого числа хранить.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Фарш говяжий»"},
    {"key": "frozenAt", "label": "Заморожено", "type": "datetime", "default": "now", "dateOnly": true},
    {"key": "storeFor", "label": "Срок хранения", "type": "duration", "default": "30d", "options": ["7d", "14d", "30d", "60d", "90d", "180d"]},
    {"key": "storage", "label": "Условия хранения", "type": "text", "default": "−18 °C и ниже", "maxLength": 30, "options": ["−18 °C и ниже", "−12 °C и ниже", "−24 °C и ниже"]},
    {"key": "amount", "label": "Количество или масса", "type": "text", "maxLength": 16, "hint": "Например, 1 кг"},
    {"key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "ЗАМОРОЖЕНО", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 3.9, "text": "Заморожено: {{frozenAt|date}}", "size": 2.8, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 25.9, "w": 53.2, "h": 4.6, "text": "Хранить до: {{frozenAt+storeFor|date}}", "size": 3.3, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 36.0, "h": 3.7, "text": "Хранение: {{storage}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 39, "y": 30.6, "w": 16.6, "h": 3.7, "text": "{{amount}}", "size": 2.7, "bold": true, "align": "right", "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 53.2, "h": 3.7, "text": "Отв.: {{employee}}", "size": 2.7, "maxLines": 1}
  ]
}
