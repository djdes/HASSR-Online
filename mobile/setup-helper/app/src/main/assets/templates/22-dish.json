{
  "id": "dish",
  "title": "Готовое блюдо",
  "description": "Кулинарная продукция: когда приготовлено и до какого времени реализовать.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "dish", "label": "Блюдо", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Плов с курицей»", "source": "dishes"},
    {"key": "cookedAt", "label": "Приготовлено", "type": "datetime", "default": "now"},
    {"key": "sellWithin", "label": "Реализовать в течение", "type": "duration", "default": "2h", "options": ["1h", "2h", "3h", "6h", "12h", "24h", "36h", "48h"]},
    {"key": "serving", "label": "Подача и хранение", "type": "text", "default": "Горячее: не ниже +65 °C", "maxLength": 40, "options": ["Горячее: не ниже +65 °C", "Холодное: +2…+6 °C", "При комнатной температуре"]},
    {"key": "employee", "label": "Повар", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "dish", "start": "cookedAt", "until": "cookedAt+sellWithin", "untilLabel": "Реализовать до", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "ГОТОВОЕ БЛЮДО", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{dish}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 3.9, "text": "Приготовлено: {{cookedAt|datetime}}", "size": 2.8, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 25.9, "w": 53.2, "h": 4.6, "text": "Реализовать до: {{cookedAt+sellWithin|datetime}}", "size": 3.3, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 53.2, "h": 3.7, "text": "{{serving}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 53.2, "h": 3.7, "text": "Повар: {{employee}}", "size": 2.7, "maxLines": 1}
  ]
}
