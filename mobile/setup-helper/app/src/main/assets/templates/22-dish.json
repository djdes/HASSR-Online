{
  "id": "dish",
  "title": "Готовое блюдо",
  "description": "Кулинарная продукция: когда приготовлено и до какого времени реализовать.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "dish", "label": "Блюдо", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Плов с курицей»"},
    {"key": "cookedAt", "label": "Приготовлено", "type": "datetime", "default": "now"},
    {"key": "sellWithin", "label": "Реализовать в течение", "type": "duration", "default": "2h", "options": ["1h", "2h", "3h", "6h", "12h", "24h", "36h", "48h"]},
    {"key": "serving", "label": "Подача и хранение", "type": "text", "default": "Горячее: не ниже +65 °C", "maxLength": 40, "options": ["Горячее: не ниже +65 °C", "Холодное: +2…+6 °C", "При комнатной температуре"]},
    {"key": "employee", "label": "Повар", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    {"type": "text", "x": 1.5, "y": 1.2, "w": 55, "h": 5.4, "text": "ГОТОВОЕ БЛЮДО", "size": 3.4, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2, "y": 7, "w": 54, "h": 8.8, "text": "{{dish}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    {"type": "line", "x": 2, "y": 16.3, "x2": 56, "y2": 16.3, "thickness": 0.3},
    {"type": "text", "x": 2, "y": 16.9, "w": 54, "h": 4.4, "text": "Приготовлено: {{cookedAt|datetime}}", "size": 3, "maxLines": 1},
    {"type": "text", "x": 2, "y": 21.5, "w": 54, "h": 5, "text": "Реализовать до: {{cookedAt+sellWithin|datetime}}", "size": 3.5, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2, "y": 26.8, "w": 54, "h": 4.2, "text": "{{serving}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 31.2, "w": 54, "h": 4.2, "text": "Повар: {{employee}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 35.6, "w": 54, "h": 3.8, "text": "{{org.name}}", "size": 2.6, "align": "right", "maxLines": 1}
  ]
}
