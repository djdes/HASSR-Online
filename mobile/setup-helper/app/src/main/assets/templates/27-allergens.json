{
  "id": "allergens",
  "title": "Аллергены",
  "description": "Предупреждение: какие аллергены есть в продукте или блюде.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт или блюдо", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Торт Наполеон»", "source": "dishes,products"},
    {"key": "allergens", "label": "Аллергены", "type": "text", "required": true, "multiline": true, "maxLength": 120, "hint": "Например: глютен, молоко, яйца, орехи"},
    {"key": "madeAt", "label": "Дата", "type": "datetime", "default": "now", "dateOnly": true},
    {"key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "product", "start": "madeAt", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "СОДЕРЖИТ АЛЛЕРГЕНЫ", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 12.0, "text": "{{allergens}}", "size": 3.2, "bold": true, "valign": "center", "maxLines": 3},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 29.4, "h": 3.7, "text": "Отв.: {{employee}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 32.2, "y": 34.4, "w": 23.4, "h": 3.7, "text": "{{madeAt|date}}", "size": 2.7, "align": "right", "maxLines": 1}
  ]
}
