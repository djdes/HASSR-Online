{
  "id": "defrost",
  "title": "Разморозка",
  "description": "Когда начали размораживать и до какого времени использовать. Повторно не замораживать.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Филе куриное»"},
    {"key": "defrostAt", "label": "Начало разморозки", "type": "datetime", "default": "now"},
    {"key": "useWithin", "label": "Использовать в течение", "type": "duration", "default": "24h", "options": ["6h", "12h", "24h", "48h"]},
    {"key": "method", "label": "Способ", "type": "text", "default": "В холодильнике +2…+4 °C", "maxLength": 40, "options": ["В холодильнике +2…+4 °C", "В пароконвектомате", "В СВЧ-печи", "Под проточной холодной водой"]},
    {"key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    {"type": "text", "x": 1.5, "y": 1.2, "w": 55, "h": 5.4, "text": "РАЗМОРОЖЕНО", "size": 3.4, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2, "y": 7, "w": 54, "h": 8.8, "text": "{{product}}", "size": 4.2, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    {"type": "line", "x": 2, "y": 16.3, "x2": 56, "y2": 16.3, "thickness": 0.3},
    {"type": "text", "x": 2, "y": 16.9, "w": 54, "h": 4.4, "text": "Начало: {{defrostAt|datetime}}", "size": 3, "maxLines": 1},
    {"type": "text", "x": 2, "y": 21.5, "w": 54, "h": 5, "text": "Использовать до: {{defrostAt+useWithin|datetime}}", "size": 3.5, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2, "y": 26.8, "w": 54, "h": 4.2, "text": "{{method}}", "size": 2.9, "maxLines": 1},
    {"type": "text", "x": 2, "y": 31.2, "w": 54, "h": 4.2, "text": "ПОВТОРНО НЕ ЗАМОРАЖИВАТЬ", "size": 2.9, "bold": true, "align": "center", "maxLines": 1},
    {"type": "text", "x": 2, "y": 35.6, "w": 36, "h": 3.8, "text": "Отв.: {{employee}}", "size": 2.6, "maxLines": 1},
    {"type": "text", "x": 39, "y": 35.6, "w": 17, "h": 3.8, "text": "{{org.name}}", "size": 2.6, "align": "right", "maxLines": 1}
  ]
}
