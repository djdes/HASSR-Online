{
  "id": "defrost",
  "title": "Разморозка",
  "description": "Когда начали размораживать и до какого времени использовать. Повторно не замораживать.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Продукт", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Филе куриное»", "source": "products"},
    {"key": "defrostAt", "label": "Начало разморозки", "type": "datetime", "default": "now"},
    {"key": "useWithin", "label": "Использовать в течение", "type": "duration", "default": "24h", "options": ["6h", "12h", "24h", "48h"]},
    {"key": "method", "label": "Способ", "type": "text", "default": "В холодильнике +2…+4 °C", "maxLength": 40, "options": ["В холодильнике +2…+4 °C", "В пароконвектомате", "В СВЧ-печи", "Под проточной холодной водой"]},
    {"key": "employee", "label": "Ответственный", "type": "text", "default": "{{user.name}}", "maxLength": 40, "source": "staff"}
  ],
  "record": {"item": "product", "start": "defrostAt", "until": "defrostAt+useWithin", "untilLabel": "Использовать до", "by": "employee"},
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "РАЗМОРОЖЕНО", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.0, "w": 53.2, "h": 7.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 20.4, "x2": 55.6, "y2": 20.4, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 20.7, "w": 53.2, "h": 3.5, "text": "Начало: {{defrostAt|datetime}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 24.3, "w": 53.2, "h": 4.2, "text": "Использовать до: {{defrostAt+useWithin|datetime}}", "size": 3.2, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 28.6, "w": 53.2, "h": 3.4, "text": "{{method}}", "size": 2.6, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 32.1, "w": 53.2, "h": 3.4, "text": "ПОВТОРНО НЕ ЗАМОРАЖИВАТЬ", "size": 2.6, "bold": true, "align": "center", "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 35.6, "w": 53.2, "h": 3.2, "text": "Отв.: {{employee}}", "size": 2.5, "maxLines": 1}
  ]
}
