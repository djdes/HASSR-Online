{
  "id": "semi-finished",
  "title": "Полуфабрикат",
  "description": "Заготовка: когда сделана, до какого времени годна, как хранить и кто готовил.",
  "size": {"width": 58, "height": 40},
  "fields": [
    {"key": "product", "label": "Наименование", "type": "text", "required": true, "maxLength": 60, "hint": "Например, «Котлеты куриные»"},
    {"key": "madeAt", "label": "Изготовлено", "type": "datetime", "default": "now"},
    {"key": "shelfLife", "label": "Срок годности", "type": "duration", "default": "24h", "options": ["6h", "12h", "18h", "24h", "36h", "48h", "72h"]},
    {"key": "storage", "label": "Условия хранения", "type": "text", "default": "+2…+6 °C", "maxLength": 30, "options": ["+2…+6 °C", "0…+4 °C", "+4…+8 °C", "−18 °C и ниже"]},
    {"key": "amount", "label": "Количество или масса", "type": "text", "maxLength": 16, "hint": "Например, 2 кг или 20 шт."},
    {"key": "employee", "label": "Изготовил", "type": "text", "default": "{{user.name}}", "maxLength": 40}
  ],
  "elements": [
    { "type": "frame", "inset": 0.8, "thickness": 0.35, "radius": 2 },
    { "type": "image", "src": "org.logo", "x": 2.4, "y": 1.9, "w": 26, "h": 5, "align": "left", "fallbackText": "{{org.name}}", "size": 2.6, "bold": true, "valign": "center", "maxLines": 1 },
    { "type": "text", "x": 29, "y": 1.9, "w": 26.6, "h": 5, "text": "{{org.site}}", "size": 2.4, "bold": true, "align": "right", "valign": "center", "maxLines": 1 },
    { "type": "line", "x": 2.4, "y": 7.6, "x2": 55.6, "y2": 7.6, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 8.4, "w": 53.2, "h": 4.4, "text": "ПОЛУФАБРИКАТ", "size": 3.2, "bold": true, "align": "center", "valign": "center", "maxLines": 1, "invert": true},
    {"type": "text", "x": 2.4, "y": 13.1, "w": 53.2, "h": 8.0, "text": "{{product}}", "size": 4.0, "bold": true, "align": "center", "valign": "center", "maxLines": 2},
    { "type": "line", "x": 2.4, "y": 21.5, "x2": 55.6, "y2": 21.5, "thickness": 0.3 },
    {"type": "text", "x": 2.4, "y": 21.9, "w": 53.2, "h": 3.9, "text": "Изготовлено: {{madeAt|datetime}}", "size": 2.8, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 25.9, "w": 53.2, "h": 4.6, "text": "Годен до: {{madeAt+shelfLife|datetime}}", "size": 3.3, "bold": true, "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 30.6, "w": 36.0, "h": 3.7, "text": "Хранить: {{storage}}", "size": 2.7, "maxLines": 1},
    {"type": "text", "x": 39, "y": 30.6, "w": 16.6, "h": 3.7, "text": "{{amount}}", "size": 2.7, "bold": true, "align": "right", "maxLines": 1},
    {"type": "text", "x": 2.4, "y": 34.4, "w": 53.2, "h": 3.7, "text": "Изготовил: {{employee}}", "size": 2.7, "maxLines": 1}
  ]
}
