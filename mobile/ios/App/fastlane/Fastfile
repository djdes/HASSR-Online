# Сборка iOS для App Store (запускает .github/workflows/mobile-release.yml).
#
#   release     — подписанный build/WeSetup.ipa, без загрузки;
#   upload_beta — загрузить уже собранный IPA в TestFlight;
#   beta        — release + upload_beta.
#
# Подпись — автоматическая, по ключу App Store Connect API: xcodebuild сам
# создаёт профили и сертификаты (-allowProvisioningUpdates), для выгрузки
# используется облачный сертификат распространения Apple. Файлы сертификатов
# в секретах не нужны. Роль ключа — Admin (см. mobile/README.md).
#
# Переменные окружения:
#   APPLE_TEAM_ID             — Team ID из developer.apple.com → Membership
#   ASC_KEY_ID, ASC_ISSUER_ID — ключ App Store Connect API
#   ASC_KEY_PATH              — путь к файлу .p8 этого ключа (кладёт CI)
#   BUILD_NUMBER              — номер сборки (build_number или номер запуска workflow)
require "json"
require "shellwords"

default_platform(:ios)

IPA_PATH = File.expand_path("../build/WeSetup.ipa", __dir__)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    in_house: false
  )
end

platform :ios do
  desc "Подписанный IPA для App Store (без загрузки)"
  lane :release do
    %w[APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH BUILD_NUMBER].each do |name|
      UI.user_error!("Не задана переменная окружения #{name}") if ENV[name].to_s.strip.empty?
    end

    # Ключи, Firebase, боевой адрес сайта и версия в User-Agent — до подписи.
    sh("node", File.expand_path("../../../scripts/release-preflight.mjs", __dir__), "--platform", "ios")

    # Временная связка ключей на CI: сюда Xcode положит сертификат разработчика.
    setup_ci if ENV["CI"]

    # Проверяет ключ .p8 заранее: ошибка в ключе видна до получасовой сборки.
    asc_api_key

    # Версия одна на Android и iOS — из mobile/package.json.
    version = JSON.parse(File.read(File.expand_path("../../../package.json", __dir__)))["version"]
    build_number = ENV["BUILD_NUMBER"]
    team_id = ENV["APPLE_TEAM_ID"]
    key_path = File.expand_path(ENV["ASC_KEY_PATH"])

    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path.shellescape}",
      "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
      "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    ].join(" ")

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "WeSetup.ipa",
      export_method: "app-store",
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Automatic " \
              "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      export_options: {
        signingStyle: "automatic",
        teamID: team_id,
        uploadSymbols: true
      }
    )
  end

  desc "Загрузить уже собранный IPA в TestFlight"
  lane :upload_beta do
    UI.user_error!("Нет build/WeSetup.ipa — сначала выполните release") unless File.file?(IPA_PATH)
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA_PATH,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Собрать IPA и загрузить в TestFlight"
  lane :beta do
    release
    upload_beta
  end
end
