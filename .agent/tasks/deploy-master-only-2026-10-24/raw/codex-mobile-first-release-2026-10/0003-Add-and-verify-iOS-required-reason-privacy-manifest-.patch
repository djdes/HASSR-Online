From ee39589bd93b6a3fcf3273d58b0465059f571525 Mon Sep 17 00:00:00 2001
From: Denis Volkov <bugdenes@gmail.com>
Date: Thu, 8 Oct 2026 00:24:58 +0300
Subject: [PATCH 3/4] Add and verify iOS required-reason privacy manifest for
 file export

---
 .github/workflows/mobile-check.yml           |   7 +
 .github/workflows/mobile-release.yml         |   1 +
 docs/mobile/07-privacy-forms.md              |   3 +
 docs/mobile/listing-values.json              |  59 ++
 mobile/ios/App/App.xcodeproj/project.pbxproj | 908 ++++++++++---------
 mobile/ios/App/App/PrivacyInfo.xcprivacy     |  17 +
 6 files changed, 543 insertions(+), 452 deletions(-)
 create mode 100644 docs/mobile/listing-values.json
 create mode 100644 mobile/ios/App/App/PrivacyInfo.xcprivacy

diff --git a/.github/workflows/mobile-check.yml b/.github/workflows/mobile-check.yml
index 4ca16f17..c980d981 100644
--- a/.github/workflows/mobile-check.yml
+++ b/.github/workflows/mobile-check.yml
@@ -100,6 +100,13 @@ jobs:
         working-directory: mobile/ios/App
         run: ruby -c fastlane/Fastfile
 
+      - name: Проверить privacy manifest внутри собранного приложения
+        run: |
+          manifest="$RUNNER_TEMP/DerivedData/Build/Products/Debug-iphonesimulator/App.app/PrivacyInfo.xcprivacy"
+          plutil -lint "$manifest"
+          test "$(/usr/libexec/PlistBuddy -c 'Print :NSPrivacyAccessedAPITypes:0:NSPrivacyAccessedAPIType' "$manifest")" = "NSPrivacyAccessedAPICategoryFileTimestamp"
+          test "$(/usr/libexec/PlistBuddy -c 'Print :NSPrivacyAccessedAPITypes:0:NSPrivacyAccessedAPITypeReasons:0' "$manifest")" = "C617.1"
+
       - name: Упаковать приложение симулятора с правами файлов
         run: tar -czf "$RUNNER_TEMP/WeSetup-ios-simulator.tar.gz" -C "$RUNNER_TEMP/DerivedData/Build/Products/Debug-iphonesimulator" App.app
 
diff --git a/.github/workflows/mobile-release.yml b/.github/workflows/mobile-release.yml
index ec930ecf..eb1749fd 100644
--- a/.github/workflows/mobile-release.yml
+++ b/.github/workflows/mobile-release.yml
@@ -198,6 +198,7 @@ jobs:
           verify_dir=$(mktemp -d "$RUNNER_TEMP/verify-ipa.XXXXXX")
           unzip -q build/WeSetup.ipa -d "$verify_dir"
           codesign --verify --deep --strict "$verify_dir/Payload/App.app"
+          plutil -lint "$verify_dir/Payload/App.app/PrivacyInfo.xcprivacy"
           test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$verify_dir/Payload/App.app/Info.plist")" = "ru.wesetup.app"
           test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$verify_dir/Payload/App.app/Info.plist")" = "$BUILD_NUMBER"
           node ../../scripts/release-manifest.mjs ios
diff --git a/docs/mobile/07-privacy-forms.md b/docs/mobile/07-privacy-forms.md
index c6cce998..b6702ecb 100644
--- a/docs/mobile/07-privacy-forms.md
+++ b/docs/mobile/07-privacy-forms.md
@@ -104,3 +104,6 @@ App Store Connect → App Privacy → Get Started. «Do you or your third-party
 - Политика доступна без входа и соответствует мобильной обработке.
 - Из текста удалены неподтверждённые обещания «аудио никуда не передаётся» и «данные не передаются третьим лицам».
 - Review accounts работают, удаление проверено, контактное лицо и правовые сведения заполнены владельцем.
+
+## Privacy manifest в iOS-сборке
+В проект добавлен `App/PrivacyInfo.xcprivacy` с причиной `C617.1` для файлового API `@capacitor/filesystem`. CI проверяет наличие декларации непосредственно в собранном приложении. Это техническая декларация используемого API; она не заменяет App Privacy и публичную политику. [Требование плагина](https://capacitorjs.com/docs/apis/filesystem).
