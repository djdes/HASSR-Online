+# Выпуск приложений WeSetup: Android (AAB → Google Play, внутреннее тестирование)
+# и iOS (→ TestFlight). Запуск вручную: Actions → «Выпуск приложений» → Run workflow.
+# Номер сборки = номер запуска этого workflow, версия — из mobile/package.json.
+# Секреты и где их взять — docs/mobile/secrets.md.
+name: Выпуск приложений
+
+on:
+  workflow_dispatch:
+    inputs:
+      platform:
+        description: "Что собрать"
+        type: choice
+        options: [both, android, ios]
+        default: both
+      track:
+        description: "Куда отправить Android"
+        type: choice
+        options: [internal, none]
+        default: none
+      play_status:
+        description: "Статус выпуска в Google Play (draft — пока приложение ни разу не выпускалось)"
+        type: choice
+        options: [completed, draft]
+        default: draft
+      upload_ios:
+        description: "Загрузить iOS в TestFlight после сборки (по умолчанию только IPA)"
+        type: boolean
+        default: false
+      build_number:
+        description: "Новый номер сборки; пусто = номер запуска workflow. Должен быть больше ранее загруженного."
+        type: string
+        default: ""
+
+env:
+  BUILD_NUMBER: ${{ inputs.build_number || github.run_number }}
+
+concurrency:
+  group: mobile-release
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+jobs:
+  android:
+    name: Android — подписанный AAB
+    if: inputs.platform != 'ios'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 40
+    defaults:
+      run:
+        working-directory: mobile
+    steps:
+      - uses: actions/checkout@v7
+
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: mobile/package-lock.json
+
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 21
+          cache: gradle
+          cache-dependency-path: |
+            mobile/android/*.gradle*
+            mobile/android/**/gradle-wrapper.properties
+
+      - run: npm ci
+      - run: npm run test:release
+
+      - name: Секреты сборки
+        env:
+          GOOGLE_SERVICES_JSON_BASE64: ${{ secrets.GOOGLE_SERVICES_JSON_BASE64 }}
+          ANDROID_KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+        run: |
+          if [ -z "$ANDROID_KEYSTORE_BASE64" ]; then
+            echo "::error::Нет секрета ANDROID_KEYSTORE_BASE64 — без ключа загрузки Google Play не примет сборку (docs/mobile/secrets.md)"
+            exit 1
+          fi
+          echo "$ANDROID_KEYSTORE_BASE64" | base64 -d > android/app/upload.jks
+          if [ -n "$GOOGLE_SERVICES_JSON_BASE64" ]; then
+            echo "$GOOGLE_SERVICES_JSON_BASE64" | base64 -d > android/app/google-services.json
+          else
+            echo "::warning::Нет секрета GOOGLE_SERVICES_JSON_BASE64 — сборка будет без push-уведомлений"
+          fi
+
+      - run: npx cap sync android
+
+      - name: Подписанный AAB
+        working-directory: mobile/android
+        env:
+          ANDROID_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          ./gradlew bundleRelease assembleRelease -PversionCode="$BUILD_NUMBER" --no-daemon
+          apksigner_path=$(find "$ANDROID_HOME/build-tools" -name apksigner | sort -V | tail -1)
+          "$apksigner_path" verify --verbose --print-certs app/build/outputs/apk/release/app-release.apk
+          keytool -printcert -jarfile app/build/outputs/bundle/release/app-release.aab > app/build/outputs/upload-certificate.txt
+          # Сборка без подписи Google Play не примет — проверяем до загрузки.
+          jarsigner -J-Duser.language=en -verify app/build/outputs/bundle/release/app-release.aab | grep -q "jar verified"
+          node ../../scripts/release-manifest.mjs android
+
+      - name: Убрать ключ с раннера
+        if: always()
+        run: rm -f android/app/upload.jks android/app/google-services.json
+
+      - uses: actions/upload-artifact@v7
+        with:
+          name: wesetup-android-${{ github.run_number }}
+          path: |
+            mobile/android/app/build/outputs/bundle/release/app-release.aab
+            mobile/android/app/build/outputs/apk/release/app-release.apk
+            mobile/android/app/build/outputs/release-manifest.json
+            mobile/android/app/build/outputs/upload-certificate.txt
+          if-no-files-found: error
+
+      - name: Внутреннее тестирование Google Play
+        if: inputs.track == 'internal'
+        uses: r0adkll/upload-google-play@v1
+        with:
+          serviceAccountJsonPlainText: ${{ secrets.GOOGLE_PLAY_SERVICE_ACCOUNT_JSON }}
+          packageName: ru.wesetup.app
+          releaseFiles: mobile/android/app/build/outputs/bundle/release/app-release.aab
+          track: internal
+          status: ${{ inputs.play_status }}
+
+  ios:
+    name: iOS — подписанный IPA
+    if: inputs.platform != 'android'
+    # macOS 26 + Xcode 26: App Store принимает только сборки на SDK iOS 26.
+    runs-on: macos-26
+    timeout-minutes: 60
+    defaults:
+      run:
+        working-directory: mobile
+    steps:
+      - uses: actions/checkout@v7
+
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: mobile/package-lock.json
+
+      - run: npm ci
+      - run: npm run test:release
+
+      - name: Секреты сборки
+        env:
+          GOOGLE_SERVICE_INFO_PLIST_BASE64: ${{ secrets.GOOGLE_SERVICE_INFO_PLIST_BASE64 }}
+          ASC_KEY_P8_BASE64: ${{ secrets.ASC_KEY_P8_BASE64 }}
+        run: |
+          if [ -z "$ASC_KEY_P8_BASE64" ]; then
+            echo "::error::Нет секрета ASC_KEY_P8_BASE64 — без ключа App Store Connect API сборку не подписать (docs/mobile/secrets.md)"
+            exit 1
+          fi
+          echo "$ASC_KEY_P8_BASE64" | base64 --decode > "$RUNNER_TEMP/asc_key.p8"
+          if [ -n "$GOOGLE_SERVICE_INFO_PLIST_BASE64" ]; then
+            echo "$GOOGLE_SERVICE_INFO_PLIST_BASE64" | base64 --decode > ios/App/App/GoogleService-Info.plist
+          else
+            echo "::warning::Нет секрета GOOGLE_SERVICE_INFO_PLIST_BASE64 — сборка будет без push-уведомлений"
+          fi
+
+      # Ставит CocoaPods-зависимости (pod install) — CocoaPods есть на раннере.
+      - run: npx cap sync ios
+
+      - uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: "3.4"
+          # Gemfile.lock не хранится в репозитории, поэтому без кеша Bundler:
+          # fastlane ставится явно шагом ниже по версии из Gemfile (~> 2.239).
+          bundler-cache: false
+          working-directory: mobile/ios/App
+
+      - name: fastlane
+        working-directory: mobile/ios/App
+        env:
+          BUNDLE_PATH: vendor/bundle
+        run: bundle install --jobs 4 --retry 3
+
+      - name: Сборка IPA и необязательная загрузка в TestFlight
+        working-directory: mobile/ios/App
+        env:
+          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
+          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
+          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
+          ASC_KEY_PATH: ${{ runner.temp }}/asc_key.p8
+          BUNDLE_PATH: vendor/bundle
+          UPLOAD_IOS: ${{ inputs.upload_ios }}
+        run: |
+          node ../../scripts/release-preflight.mjs --platform ios
+          bundle exec fastlane release
+          verify_dir=$(mktemp -d "$RUNNER_TEMP/verify-ipa.XXXXXX")
+          unzip -q build/WeSetup.ipa -d "$verify_dir"
+          codesign --verify --deep --strict "$verify_dir/Payload/App.app"
+          test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$verify_dir/Payload/App.app/Info.plist")" = "ru.wesetup.app"
+          test "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$verify_dir/Payload/App.app/Info.plist")" = "$BUILD_NUMBER"
+          node ../../scripts/release-manifest.mjs ios
+          if [ "$UPLOAD_IOS" = "true" ]; then
+            bundle exec fastlane upload_beta
+          fi
+
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: wesetup-ios-${{ github.run_number }}
+          path: |
+            mobile/ios/App/build/WeSetup.ipa
+            mobile/ios/App/build/release-manifest.json
+            mobile/ios/App/build/WeSetup.app.dSYM.zip
+          if-no-files-found: warn
+
+      - name: Убрать ключи с раннера
+        if: always()
+        run: rm -f "$RUNNER_TEMP/asc_key.p8" ios/App/App/GoogleService-Info.plist
diff --git a/mobile/android/app/build.gradle b/mobile/android/app/build.gradle
index 4de79ad8..6a07eba6 100644
--- a/mobile/android/app/build.gradle
+++ b/mobile/android/app/build.gradle
@@ -7,9 +7,20 @@ def appVersionCode = project.hasProperty('versionCode') ? project.property('vers
 
 // Ключ загрузки Google Play: файл app/upload.jks кладёт CI из секрета
 // ANDROID_KEYSTORE_BASE64, пароли — из переменных окружения. Без файла
-// release-сборка остаётся неподписанной (для локальной проверки этого хватает).
+// store release is blocked without signing and Firebase configuration.
 def uploadKeystore = file('upload.jks')
 
+// Apply the same guard to local Gradle builds and CI. Debug builds need no secrets.
+gradle.taskGraph.whenReady { graph ->
+    if (['bundleRelease', 'assembleRelease', 'packageRelease', 'signReleaseBundle'].any { graph.hasTask(":app:${it}") }) {
+        project.exec {
+            workingDir rootProject.projectDir.parentFile
+            environment 'BUILD_NUMBER', appVersionCode.toString()
+            commandLine 'node', 'scripts/release-preflight.mjs', '--platform', 'android'
+        }
+    }
+}
+
 android {
     namespace = "ru.wesetup.app"
     compileSdk = rootProject.ext.compileSdkVersion
diff --git a/mobile/ios/App/fastlane/Fastfile b/mobile/ios/App/fastlane/Fastfile
index f9f4df47..f80b4121 100644
--- a/mobile/ios/App/fastlane/Fastfile
+++ b/mobile/ios/App/fastlane/Fastfile
@@ -1,72 +1,91 @@
-# Сборка iOS и отправка в TestFlight (запускает .github/workflows/mobile-release.yml).
-#
-# Подпись — автоматическая, по ключу App Store Connect API: xcodebuild сам
-# создаёт профили и сертификаты (-allowProvisioningUpdates), для выгрузки
-# используется облачный сертификат распространения Apple. Файлы сертификатов
-# в секретах не нужны. Роль ключа — Admin (см. mobile/README.md).
-#
-# Переменные окружения:
-#   APPLE_TEAM_ID            — Team ID из developer.apple.com → Membership
-#   ASC_KEY_ID, ASC_ISSUER_ID — ключ App Store Connect API
-#   ASC_KEY_PATH             — путь к файлу .p8 этого ключа (кладёт CI)
-#   BUILD_NUMBER             — номер сборки (номер запуска workflow)
-require "json"
-require "shellwords"
-
-default_platform(:ios)
-
-platform :ios do
-  desc "Подписанная сборка App Store → TestFlight"
-  lane :beta do
-    %w[APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH BUILD_NUMBER].each do |name|
-      UI.user_error!("Не задана переменная окружения #{name}") if ENV[name].to_s.strip.empty?
-    end
-
-    # Временная связка ключей на CI: сюда Xcode положит сертификат разработчика.
-    setup_ci if ENV["CI"]
-
-    key_path = File.expand_path(ENV["ASC_KEY_PATH"])
-    api_key = app_store_connect_api_key(
-      key_id: ENV["ASC_KEY_ID"],
-      issuer_id: ENV["ASC_ISSUER_ID"],
-      key_filepath: key_path,
-      in_house: false
-    )
-
-    # Версия одна на Android и iOS — из mobile/package.json.
-    version = JSON.parse(File.read(File.expand_path("../../../package.json", __dir__)))["version"]
-    build_number = ENV["BUILD_NUMBER"]
-    team_id = ENV["APPLE_TEAM_ID"]
-
-    auth = [
-      "-allowProvisioningUpdates",
-      "-authenticationKeyPath #{key_path.shellescape}",
-      "-authenticationKeyID #{ENV['ASC_KEY_ID']}",
-      "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
-    ].join(" ")
-
-    build_app(
-      workspace: "App.xcworkspace",
-      scheme: "App",
-      configuration: "Release",
-      clean: true,
-      output_directory: "build",
