From: Denis Volkov <bugdenes@gmail.com>
Date: Thu, 8 Oct 2026 00:30:03 +0300
Subject: [PATCH 4/4] Preserve Unix newlines in the Xcode Firebase copy phase

---
 mobile/ios/App/App.xcodeproj/project.pbxproj | 11 +----------
 1 file changed, 1 insertion(+), 10 deletions(-)

diff --git a/mobile/ios/App/App.xcodeproj/project.pbxproj b/mobile/ios/App/App.xcodeproj/project.pbxproj
index cb63c498..9b17bd90 100644
--- a/mobile/ios/App/App.xcodeproj/project.pbxproj
+++ b/mobile/ios/App/App.xcodeproj/project.pbxproj
@@ -198,16 +198,7 @@
 			);
 			runOnlyForDeploymentPostprocessing = 0;
 			shellPath = /bin/sh;
-			shellScript = "# GoogleService-Info.plist (Firebase, push) is written into App/ by CI from a secret.
-# Without it the app still builds and runs, just without push.
-SRC=\"${SRCROOT}/App/GoogleService-Info.plist\"
-if [ -f \"$SRC\" ]; then
-  cp \"$SRC\" \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist\"
-  echo \"GoogleService-Info.plist added to the app bundle\"
-else
-  echo \"warning: GoogleService-Info.plist not found - push notifications are disabled in this build\"
-fi
-";
+			shellScript = "# GoogleService-Info.plist (Firebase, push) is written into App/ by CI from a secret.\n# Without it the app still builds and runs, just without push.\nSRC=\"${SRCROOT}/App/GoogleService-Info.plist\"\nif [ -f \"$SRC\" ]; then\n  cp \"$SRC\" \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist\"\n  echo \"GoogleService-Info.plist added to the app bundle\"\nelse\n  echo \"warning: GoogleService-Info.plist not found - push notifications are disabled in this build\"\nfi\n";
 			showEnvVarsInLog = 0;
 		};
